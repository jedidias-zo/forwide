---
import { getLocale, localisePath } from "../i18n";
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from "../components/layout/Footer.astro";
import PageReveals from "../components/animations/PageReveals.astro";
import SmoothScroll from "../components/animations/SmoothScroll.astro";
import CursorDot from "../components/animations/CursorDot.astro";

type Props = {
	title?: string;
	headerHomeVariant?: "label" | "logo";
	headerTheme?: "light" | "dark";
};

const {
	title = "Forwide",
	headerHomeVariant = "label",
	headerTheme = "light",
} = Astro.props;
const locale = getLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="alternate" hreflang="es" href={localisePath(Astro.url.pathname, "es")} />
		<link rel="alternate" hreflang="en" href={localisePath(Astro.url.pathname, "en")} />
		<link rel="alternate" hreflang="x-default" href={localisePath(Astro.url.pathname, "es")} />
	</head>

	<body>
		<Header homeVariant={headerHomeVariant} theme={headerTheme} />
		<main>
			<slot />
		</main>

		<Footer />
		<PageReveals />
		<SmoothScroll />
		<CursorDot />
	</body>
</html>
