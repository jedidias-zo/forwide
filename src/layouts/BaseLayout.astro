---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from "../components/layout/Footer.astro";
import PageReveals from "../components/animations/PageReveals.astro";
import SmoothScroll from "../components/animations/SmoothScroll.astro";
import CursorDot from "../components/animations/CursorDot.astro";

type Props = {
	title?: string;
	headerHomeVariant?: "label" | "logo";
};

const {
	title = "Forwide",
	headerHomeVariant = "label",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>

	<body>
		<Header homeVariant={headerHomeVariant} />
		<main>
			<slot />
		</main>

		<Footer />
		<PageReveals />
		<SmoothScroll />
		<CursorDot />
	</body>
</html>
