---
import EditableImage from "../components/ui/EditableImage.astro";
import editableImage0 from "../assets/sections/what-is-forwide/product-base.png";
import editableImage1 from "../assets/sections/what-is-forwide/system-base.png";
import editableImage2 from "../assets/sections/what-is-forwide/base-scale.png";
import editableImage3 from "../assets/livecook/livecook-food-001.png";
import BilingualText from "../components/ui/BilingualText.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WhatIsForwide from '../components/sections/WhatIsForwide.astro';
import NextStepsSection from '../components/sections/NextStepsSection.astro';
import SignalsSection from '../components/sections/SignalsSection.astro';
import BrandLogoSection from '../components/sections/BrandLogoSection.astro';
---

<BaseLayout>
	<Hero>
		<BilingualText slot="intro" spanish="Forwide es una empresa tecnológica concebida como la estructura matriz para el desarrollo, lanzamiento y escalabilidad de productos digitales.

LiveCook es su primer proyecto activo y representa el punto de partida para validar la infraestructura tecnológica, los procesos operativos y el modelo de negocio. Su evolución permitirá consolidar el conocimiento y la experiencia necesarios para desarrollar nuevas verticales de negocio bajo una estrategia de crecimiento estructurada, eficiente y sostenible." english="Forwide is a technology company designed to serve as the foundation for developing, launching, and scaling digital products.

LiveCook is its first active project and represents the starting point for validating its technological infrastructure, operational processes, and business model. Its evolution will help consolidate the knowledge and expertise needed to develop new business verticals through a structured, efficient, and sustainable growth strategy." />
		<BilingualText slot="headline-0-0" spanish="CREAMOS TECNOLOGÍA." english="WE CREATE TECHNOLOGY." />
		<BilingualText slot="headline-1-0" spanish="CONSTRUIMOS " english="WE BUILD " />
		<BilingualText slot="headline-1-1" spanish="OPORTUNIDADES." english="OPPORTUNITIES." />
	</Hero>
	<WhatIsForwide>
		<BilingualText slot="eyebrow" spanish="[ Qué es Forwide ]" english="[ What is Forwide ]" />
		<BilingualText slot="title" spanish="UNA VISIÓN TECNOLÓGICA, MÚLTIPLES POSIBILIDADES." english="ONE TECHNOLOGICAL VISION, MULTIPLE POSSIBILITIES." />
		<BilingualText slot="intro" spanish="Forwide es una compañía tecnológica dedicada a la conceptualización, desarrollo y escalabilidad de productos digitales propios. Integramos tecnología, innovación y estrategia empresarial para construir modelos de negocio sostenibles, capaces de evolucionar y expandirse hacia el mercado global." english="Forwide is a technology company dedicated to conceptualizing, developing, and scaling its own digital products. We integrate technology, innovation, and business strategy to build sustainable business models capable of evolving and expanding into global markets." />
		<BilingualText slot="pillar-0-index" spanish="001" english="001" />
		<BilingualText slot="pillar-1-index" spanish="002" english="002" />
		<BilingualText slot="pillar-2-index" spanish="003" english="003" />
		<BilingualText slot="pillar-0-title" spanish="Base de producto" english="Product foundation" />
		<BilingualText slot="pillar-1-title" spanish="Base de sistema" english="System foundation" />
		<BilingualText slot="pillar-2-title" spanish="Base de escala" english="GROWTH FOUNDATION" />
		<BilingualText slot="pillar-0-body" spanish="Identificamos una necesidad concreta y diseñamos un producto digital para resolverla." english="We identify a specific need and design a digital product to address it." />
		<BilingualText slot="pillar-1-body" spanish="Construimos tecnología y procesos que podemos reutilizar en distintas plataformas." english="We build technology and processes that can be reused across different platforms." />
		<BilingualText slot="pillar-2-body" spanish="Usamos lo que aprendemos con usuarios reales para decidir qué mejorar, cuándo ampliar el alcance y qué productos desarrollar después." english="We use insights from real users to determine what to improve, when to scale, and which products to develop next." />
		<EditableImage slot="image-0-0" src={editableImage0} spanishAlt="" englishAlt="" class="h-full w-full object-cover object-center" loading="lazy" decoding="async" />
		<EditableImage slot="image-0-1" src={editableImage1} spanishAlt="" englishAlt="" class="h-full w-full object-cover object-center" loading="lazy" decoding="async" />
		<EditableImage slot="image-0-2" src={editableImage2} spanishAlt="" englishAlt="" class="h-full w-full object-cover object-center" loading="lazy" decoding="async" />
	</WhatIsForwide>
	<NextStepsSection steps={[]}>
		<BilingualText slot="kicker" spanish="[ FORWIDE COMO ECOSISTEMA DE PRODUCTOS ]" english="[ FORWIDE AS A PRODUCT ECOSYSTEM ]" />
		<BilingualText slot="headline" spanish="Forwide organiza presente y futuro bajo una misma capa de método, tecnología y marca." english="Forwide brings the present and the future together through a shared approach, technology and brand." />
		<BilingualText slot="description" preserveLineBreaks={false} spanish="Cada iniciativa de Forwide responde a una oportunidad específica de mercado, con identidad, propósito y propuesta de valor propios. Esta filosofía permite diversificar nuestra actividad sin perder la coherencia de nuestra visión empresarial." english="Each Forwide initiative addresses a specific market opportunity, with its own identity, purpose, and value proposition. This philosophy allows us to diversify our business while maintaining a cohesive corporate vision." />
		<SignalsSection productOnly embedded>
		<BilingualText slot="title" spanish="Señales de una empresa de tecnología." english="The signs of a technology company." />
		<BilingualText slot="intro" spanish="La compañía ya muestra tres señales: un producto activo, una estructura reutilizable y una dirección capaz de abrir nuevos verticales." english="The company already shows three signs: an active product, a reusable structure and a clear direction for entering new verticals." />
		<BilingualText slot="bridgeTitle" spanish="Lo que se aprende en un vertical puede mejorar el siguiente." english="What we learn in one vertical can improve the next." />
		<BilingualText slot="bridgeBody" spanish="Ya existe un caso activo para probar experiencia, contenido, operación y tecnología en condiciones reales." english="An active venture is already testing experience, content, operations and technology in real-world conditions." />
		<BilingualText slot="row-0-title" spanish="DEL CONCEPTO A LA REALIDAD." english="FROM CONCEPT TO REALITY." />
		<BilingualText slot="row-0-body" preserveLineBreaks={false} spanish="LiveCook materializa la visión empresarial de
Forwide y permite evaluar la experiencia de
usuario, la interacción con el mercado y la
eficiencia operativa en un entorno real." english="LiveCook brings Forwide’s business vision to life, allowing us to evaluate user experience, market engagement, and operational efficiency in a real-world environment." />
		<EditableImage slot="image-0-0" src={editableImage3} spanishAlt="Proceso de cocina usado como caso activo de LiveCook." englishAlt="Cooking in progress as part of LiveCook's active venture." class="h-[6rem] w-full object-cover object-center lg:h-[6.2rem]" loading="lazy" />
	</SignalsSection>
	</NextStepsSection>
	<BrandLogoSection />
</BaseLayout>
