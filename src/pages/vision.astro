---
import EditableImage from "../components/ui/EditableImage.astro";
import editableImage0 from "../assets/vision/hero/asset-000.png";
import editableImage4 from "../assets/livecook-product-page/livecook-icon.png";
import editableImage5 from "../assets/vision/visible/asset-01.png";
import editableImage7 from "../assets/livecook-product-page/grid-03.png";
import editableImage8 from "../assets/vision/zoom-out-animation/asset-00.png";
import editableImage9 from "../assets/vision/zoom-out-animation/asset-03.png";
import editableImage10 from "../assets/vision/zoom-out-animation/asset-01.png";
import editableImage11 from "../assets/vision/zoom-out-animation/asset-04.png";
import editableImage12 from "../assets/vision/zoom-out-animation/asset-05.png";
import editableImage13 from "../assets/vision/zoom-out-animation/asset-06.png";
import editableImage14 from "../assets/vision/zoom-out-animation/asset-07.png";
import BilingualText from "../components/ui/BilingualText.astro";
import { createTranslator, getLocale } from "../i18n";
const t = createTranslator(getLocale(Astro.url.pathname));

import BaseLayout from "../layouts/BaseLayout.astro";
import VisionHero from "../components/sections/VisionHero.astro";
import VisionVisibleSection from "../components/sections/VisionVisibleSection.astro";
import VisionZoomOutSection from "../components/sections/VisionZoomOutSection.astro";
import asset_001 from '../assets/vision/hero/asset-001.png';
---

<BaseLayout title={t("Vision | Forwide")} headerHomeVariant="logo">
	<VisionHero>
		<BilingualText slot="kicker" spanish="[ Nuestro manifiesto ]" english="[ Our manifesto ]" />
		<BilingualText slot="body" spanish="Forwide convierte cada producto en tecnología, operación y aprendizaje reutilizable. LiveCook es el primer caso visible; la ambición es una compañía capaz de abrir nuevos verticales sin perder coherencia." english="Forwide turns each product into reusable technology, operations and knowledge. LiveCook is the first visible example; our ambition is to build a company that can enter new verticals while staying coherent." />
		<BilingualText slot="headline" preserveLineBreaks={false} spanish="No lanzamos apps sueltas. Construimos una base para lanzar mejor cada vez." english="We don't launch isolated apps. We build a foundation to launch better every time." />
		<EditableImage slot="image-0" src={editableImage0} spanishAlt="" englishAlt="" class="aspect-[1.18] w-full object-cover object-[50%_26%] grayscale contrast-125 lg:w-[min(45vw,46rem)]" loading="eager" decoding="async" data-vision-morph-source />
	</VisionHero>
	<VisionVisibleSection>
		<BilingualText slot="body" spanish="Cada producto de Forwide puede tener identidad, propósito y dinámica propios. Debajo, todos comparten una estructura de tecnología, operación, marca, aprendizaje y pensamiento de sistema." english="Each Forwide product can have its own identity, purpose and dynamics. Underneath, they all share a foundation of technology, operations, brand, knowledge and systems thinking." />
		<BilingualText slot="system-0" spanish="[ OBSERVAR ]" english="[ OBSERVE ]" />
		<BilingualText slot="system-1" spanish="[ DESCUBRIR ]" english="[ DISCOVER ]" />
		<BilingualText slot="system-2" spanish="[ PROYECTAR ]" english="[ ENVISION ]" />
		<BilingualText slot="community-0" spanish="[ DISEÑAR ]" english="[ DESIGN ]" />
		<BilingualText slot="community-1" spanish="[ CONSTRUIR ]" english="[ BUILD ]" />
		<BilingualText slot="community-2" spanish="[ PERFECCIONAR ]" english="[ REFINE ]" />
		<BilingualText slot="text-0" spanish="CRECER" english="GROW" />
		<EditableImage slot="image-0" src={editableImage4} spanishAlt="" englishAlt="" class="h-[78%] w-[78%] object-contain" loading="lazy" />
		<EditableImage slot="image-1" src={editableImage5} spanishAlt="" englishAlt="" class="absolute inset-0 h-full w-full object-cover grayscale" loading="lazy" decoding="async" data-visible-reveal-fade />
		<EditableImage slot="image-2" src={asset_001} spanishAlt="" englishAlt="" class="absolute inset-0 h-full w-full object-cover grayscale" loading="lazy" decoding="async" data-visible-reveal-fade />
		<EditableImage slot="image-3" src={editableImage7} spanishAlt="" englishAlt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" data-visible-reveal-fade />
	</VisionVisibleSection>
	<VisionZoomOutSection>
		<BilingualText slot="stage-0-word" spanish="¿Qué es Forwide?" english="What is Forwide?" />
		<BilingualText slot="stage-1-word" spanish="FUNCIONAL" english="FUNCTIONAL" />
		<BilingualText slot="stage-2-word" spanish="INTEGRADA" english="INTEGRATED" />
		<BilingualText slot="stage-3-word" spanish="ADAPTABLE" english="ADAPTABLE" />
		<BilingualText slot="stage-4-word" spanish="PROGRESIVA" english="PROGRESSIVE" />
		<BilingualText slot="stage-1-copy" preserveLineBreaks={false} spanish="Diseñamos soluciones donde cada componente responde a una necesidad específica, bajo criterios de precisión, rendimiento y eficiencia." english="We design solutions where every component serves a specific need, guided by principles of precision, performance, and efficiency." />
		<BilingualText slot="stage-2-copy" preserveLineBreaks={false} spanish="Concebimos arquitecturas interconectadas que favorecen la interoperabilidad y la optimización de recursos." english="We design interconnected architectures that promote interoperability and optimize resource utilization." />
		<BilingualText slot="stage-3-copy" preserveLineBreaks={false} spanish="Anticipamos escenarios emergentes mediante sistemas flexibles, preparados para responder a nuevas exigencias del entorno digital." english="We anticipate emerging scenarios through flexible systems designed to respond to the evolving demands of the digital landscape." />
		<BilingualText slot="stage-4-copy" preserveLineBreaks={false} spanish="Incorporamos la evolución como principio de
diseño, ampliando nuestras capacidades a
través del refinamiento continuo y la innovación
aplicada." english="We embrace evolution as a design principle, expanding our capabilities through continuous refinement and applied innovation." />
		<EditableImage slot="image-0-0" src={editableImage8} spanishAlt="" englishAlt="" class="h-full w-full object-cover" loading="eager" decoding="async" />
		<EditableImage slot="image-0-1" src={editableImage9} spanishAlt="" englishAlt="" class="h-full w-full object-cover" loading="eager" decoding="async" />
		<EditableImage slot="image-0-2" src={editableImage10} spanishAlt="" englishAlt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
		<EditableImage slot="image-0-3" src={editableImage11} spanishAlt="" englishAlt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
		<EditableImage slot="image-0-4" src={editableImage12} spanishAlt="" englishAlt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
		<EditableImage slot="image-0-5" src={editableImage13} spanishAlt="" englishAlt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
		<EditableImage slot="image-0-6" src={editableImage14} spanishAlt="" englishAlt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
	</VisionZoomOutSection>
</BaseLayout>
