---
import BilingualText from "../components/ui/BilingualText.astro";
import EditableImage from "../components/ui/EditableImage.astro";
import contactImage from "../assets/responsabilidad-page/asset-03.png";
import { createTranslator, getLocale } from "../i18n";
const t = createTranslator(getLocale(Astro.url.pathname));
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactSection from "../components/sections/ContactSection.astro";
---

<BaseLayout title={t("Contáctanos | Forwide")} headerHomeVariant="logo">
	<ContactSection>
		<BilingualText slot="title" spanish="Contacto" english="Contact" />
		<BilingualText slot="legal-label" spanish="Legal" english="Legal" />
		<BilingualText slot="legal-email" spanish="admin@forwide.com" english="admin@forwide.com" />
		<BilingualText slot="support-label" spanish="Soporte general" english="General support" />
		<BilingualText slot="support-email" spanish="support@forwide.com" english="support@forwide.com" />
		<EditableImage slot="image" src={contactImage} spanishAlt="" englishAlt="" class="h-full w-full object-cover grayscale" loading="eager" />
	</ContactSection>
</BaseLayout>
