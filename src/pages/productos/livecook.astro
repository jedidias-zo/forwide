---
import EditableImage from "../../components/ui/EditableImage.astro";
import editableImage0 from "../../assets/vision/full-width.png";
import editableImage1 from "../../assets/livecook-product-page/livecook-hero-phone.png";
import editableImage2 from "../../assets/livecook-product-page/section_layers/asset-05.png";
import BilingualText from "../../components/ui/BilingualText.astro";
import { createTranslator, getLocale } from "../../i18n";
const t = createTranslator(getLocale(Astro.url.pathname));
import BaseLayout from "../../layouts/BaseLayout.astro";
import LiveCookProductHero from "../../components/sections/LiveCookProductHero.astro";
import LiveCookShowcaseHero from "../../components/sections/LiveCookShowcaseHero.astro";
import LiveCookProductProofSection from "../../components/sections/LiveCookProductProofSection.astro";
---

<BaseLayout title={t("Productos | Forwide")}>
	<LiveCookProductHero>
		<BilingualText slot="title" spanish="Productos" english="Products" />
		<BilingualText slot="intro" spanish="Cada producto de Forwide tiene su propia marca y su propio público. Todos funcionan sobre la misma tecnología." english="Each Forwide product has its own brand and audience. They all run on the same technology." />
		<BilingualText slot="body" spanish="Clases de cocina en directo con chefs reales: cocinas a la vez que el chef, preguntas en el momento y terminas con tu plato hecho." english="Live cooking classes with real chefs: cook alongside the chef, ask questions as you go and finish with a dish you've made yourself." />
		<BilingualText slot="cta-label" spanish="Conocer LiveCook" english="Discover LiveCook" />
		<EditableImage slot="image-0" src={editableImage0} spanishAlt="Cocina profesional con superficies de acero y luces cálidas." englishAlt="A professional kitchen with steel surfaces and warm lighting." class="aspect-[1.35] w-full object-cover object-center sm:aspect-auto sm:h-auto" loading="eager" fetchpriority="high" decoding="async" />
	</LiveCookProductHero>
	<LiveCookShowcaseHero>
		<BilingualText slot="products-label" spanish="[ Nuestros productos ]" english="[ Our products ]" />
		<BilingualText slot="products-title" preserveLineBreaks={false} spanish="Distintos universos. Un mismo origen." english="DIFFERENT WORLDS. ONE SHARED ORIGIN." />
		<BilingualText slot="products-body" preserveLineBreaks={false} spanish="Cada plataforma de Forwide cuenta con una
identidad independiente, una audiencia
específica y una propuesta de valor diferenciada, respaldadas por una arquitectura tecnológica común." english="Each Forwide platform has its own identity, target audience, and distinct value proposition, supported by a shared technological architecture." />
		<BilingualText slot="label" spanish="[ LiveCook ]" english="[ LiveCook ]" />
		<BilingualText slot="title" preserveLineBreaks={false} spanish="La gastronomía sin fronteras. En tiempo real." english="CULINARY EXPERIENCES WITHOUT BORDERS. IN REAL TIME." />
		<BilingualText slot="body" preserveLineBreaks={false} spanish="LiveCook transforma la manera de aprender y compartir la gastronomía. Una plataforma interactiva que conecta a profesionales y apasionados de la cocina con personas de todo el mundo." english="LiveCook transforms the way people learn and share the art of cooking. An interactive platform that connects culinary professionals and cooking enthusiasts with people around the world." />
		<BilingualText slot="experience" preserveLineBreaks={false} spanish="Participa en clases en directo, cocina junto a chefs, resuelve tus dudas al instante y descubre nuevas culturas culinarias desde tu propia cocina." english="Join live classes, cook alongside chefs, get your questions answered instantly, and discover new culinary cultures from your own kitchen." />
		<BilingualText slot="cta-label" spanish="Conocer LiveCook" english="Discover LiveCook" />
		<EditableImage slot="image-0" src={editableImage1} spanishAlt="Mockup de LiveCook mostrando el perfil de una chef dentro de la app." englishAlt="A LiveCook mockup showing a chef's profile in the app." class="h-auto w-full" loading="lazy" decoding="async" />
	</LiveCookShowcaseHero>
	<LiveCookProductProofSection>
		<BilingualText slot="brand" spanish="LiveCook" english="LiveCook" />
		<BilingualText slot="text-0" spanish="LIVECOOK INAUGURA UNA NUEVA ETAPA PARA FORWIDE." english="LIVECOOK MARKS A NEW CHAPTER FOR FORWIDE." />
		<BilingualText slot="text-1" spanish="Con LiveCook, Forwide materializa su entrada
en el mercado de las plataformas interactivas,
integrando comunicación audiovisual en tiempo
real, conocimiento culinario y participación
activa en una experiencia que trasciende los
formatos tradicionales de aprendizaje." english="With LiveCook, Forwide enters the interactive platform market, combining real-time audiovisual communication, culinary expertise, and active participation to deliver an experience that goes beyond traditional learning formats." />
		<EditableImage slot="image-0" src={editableImage2} spanishAlt="Teléfono iluminado sostenido en una mano." englishAlt="An illuminated phone held in a hand." class="w-full" loading="lazy" decoding="async" />
	</LiveCookProductProofSection>
</BaseLayout>
