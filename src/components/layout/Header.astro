---
import NavLink from '../ui/NavLink.astro';
import forwideLogoStroke from '../../assets/logos/forwide-logo-stroke.svg';
import ForwideLogo from '../brand/ForwideLogo.astro';

type NavItem = {
	label: string;
	href: string;
	isActive?: boolean;
};

type Props = {
	homeLabel?: string;
	homeHref?: string;
	homeVariant?: "label" | "logo";
	theme?: "light" | "dark";
	navItems?: NavItem[];
	contactHref?: string;
};

const {
	homeLabel = "[HOME]",
	homeHref = "/",
	homeVariant = "label",
	theme = "light",
	navItems = [
		{ label: "HOME", href: "/" },
		{ label: "VISION", href: "/vision" },
		{ label: "PRODUCTOS", href: "/productos/livecook/" },
		{ label: "RESPONSABILIDAD", href: "/responsabilidad" },
		{ label: "CONTÁCTANOS", href: "/contactanos" },
	],
	contactHref = "mailto:hola@forwide.com",
} = Astro.props;

const stripTrailingSlash = (path: string) =>
	path === "/" ? "/" : path.replace(/\/+$/, "");

const currentPath = stripTrailingSlash(Astro.url.pathname);
const homeIsActive = currentPath === "/";

const getNavPath = (href: string) => {
	if (href.startsWith("#") || href.startsWith("mailto:")) return null;

	const url = new URL(href, Astro.url);
	if (url.hash) return null;

	return stripTrailingSlash(url.pathname);
};

const isNavItemActive = (href: string) => {
	const navPath = getNavPath(href);
	if (!navPath) return false;
	if (navPath.startsWith("/productos")) return currentPath.startsWith("/productos");

	return currentPath === navPath;
};

/*
 * Menu open/close styles use data-open on #site-menu.
 * Size and spacing tokens live in src/styles/global.css:
 *   --menu-link-size, --menu-link-gap, --frame-inset, --header-height
 * Menu links use the text-menu-link utility (28px mobile → 72px desktop).
 */
const menuOverlayClasses = [
	"fixed inset-0 z-[70] flex min-h-dvh flex-col bg-surface-menu text-foreground",
	"opacity-0 pointer-events-none translate-y-2",
	"transition-[opacity,transform] duration-slow ease-standard",
	"data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0",
].join(" ");
---

<header
	class:list={[
		"fixed inset-x-0 top-0 z-50 h-header bg-transparent transition-colors duration-normal ease-standard",
		theme === "dark" && "[--foreground:var(--surface-dark-foreground)] [--hero-threads:var(--surface-dark-foreground)] [--primary:var(--surface-dark-foreground)]",
	]}
	data-site-header
	data-reveal-header
>
	<div class="mx-auto flex h-full max-w-none items-center justify-between px-[var(--frame-inset)]">
		<a
			href={homeHref}
			class:list={[
				"ml-2 transition-colors duration-fast hover:text-primary focus-visible:text-primary md:ml-0",
				homeVariant === "logo"
					? "block w-[min(7.25rem,30vw)] text-foreground md:w-[min(9rem,34vw)]"
					: "text-[0.875rem] font-normal leading-none text-foreground underline-offset-2 [letter-spacing:0] md:text-[1rem]",
				homeVariant === "label" && homeIsActive && "line-through decoration-1",
			]}
		>
			{homeVariant === "logo" ? <ForwideLogo class="h-auto w-full" /> : homeLabel}
		</a>

		<div class="flex items-center gap-7">
			<a
				href={contactHref}
				aria-label="Contactar por email"
				class="hidden text-foreground transition-colors duration-fast hover:text-primary focus-visible:text-primary sm:block"
			>
				<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75">
					<path d="M4 6.5h16v11H4z"></path>
					<path d="m4.75 7.25 7.25 6 7.25-6"></path>
				</svg>
			</a>

			<button
				type="button"
				data-menu-open
				aria-controls="site-menu"
				aria-expanded="false"
				aria-label="Abrir menu"
				class="group flex size-7 items-center justify-center text-[var(--hero-threads)] transition-colors duration-fast hover:text-foreground focus-visible:text-foreground"
			>
				<span class="flex w-6 flex-col items-end gap-1.5">
					<span class="h-0.5 w-6 rounded-full bg-current transition-all duration-normal group-hover:w-5"></span>
					<span class="h-0.5 w-3 rounded-full bg-current transition-all duration-normal group-hover:w-6"></span>
				</span>
			</button>
		</div>
	</div>
	<span
		data-header-rule
		class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left scale-x-100 bg-foreground transition-transform duration-500 ease-standard"
		aria-hidden="true"
	></span>
</header>

<div
	id="site-menu"
	data-menu-overlay
	data-open="false"
	aria-hidden="true"
	inert
	class={menuOverlayClasses}
>
	<div class="flex h-header shrink-0 items-center justify-between px-[var(--frame-inset)]">
		<a
			href={homeHref}
			aria-label="Forwide home"
			class="block w-[min(11rem,28vw)]"
		>
			<img src={forwideLogoStroke.src} alt="Forwide" class="h-auto w-full invert" />
		</a>

		<button
			type="button"
			data-menu-close
			aria-label="Cerrar menu"
			class="flex size-10 shrink-0 items-center justify-center text-foreground transition-transform duration-normal hover:rotate-90 focus-visible:rotate-90"
		>
			<span class="relative block size-8">
				<span class="absolute left-1/2 top-1/2 h-0.5 w-8 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-current"></span>
				<span class="absolute left-1/2 top-1/2 h-0.5 w-8 -translate-x-1/2 -translate-y-1/2 -rotate-45 bg-current"></span>
			</span>
		</button>
	</div>

	<nav
		aria-label="Menu principal"
		class="flex min-h-0 flex-1 flex-col items-center overflow-y-auto overscroll-contain px-[var(--frame-inset)] pb-[var(--frame-inset)]"
	>
		<ul class="my-auto flex w-full max-w-[min(100%,64rem)] flex-col items-center gap-[var(--menu-link-gap)] py-[clamp(1rem,3vh,2.5rem)] text-menu-link leading-none">
			{
				navItems.map((item) => (
					<li>
						<NavLink
							label={item.label}
							href={item.href}
							isActive={item.isActive ?? isNavItemActive(item.href)}
							class="text-foreground"
						/>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<script>
	const openButton = document.querySelector("[data-menu-open]");
	const closeButton = document.querySelector("[data-menu-close]");
	const menu = document.querySelector<HTMLElement>("[data-menu-overlay]");
	const menuLinks = menu?.querySelectorAll("a");

	const setMenuOpen = (isOpen: boolean) => {
		if (!menu || !openButton) return;

		document.body.classList.toggle("menu-open", isOpen);
		openButton.setAttribute("aria-expanded", String(isOpen));
		menu.setAttribute("aria-hidden", String(!isOpen));
		menu.setAttribute("data-open", String(isOpen));

		if (isOpen) {
			menu.removeAttribute("inert");
		} else {
			menu.setAttribute("inert", "");
		}
	};

	openButton?.addEventListener("click", () => setMenuOpen(true));
	closeButton?.addEventListener("click", () => setMenuOpen(false));
	menuLinks?.forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") setMenuOpen(false);
	});

	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const headerRule = document.querySelector<HTMLElement>("[data-header-rule]");
	let headerRuleFrame = 0;

	const isTransparentColor = (color: string) => {
		if (!color || color === "transparent") return true;
		if (color === "rgba(0, 0, 0, 0)") return true;

		return /^rgba\(.+,\s*0(?:\.0+)?\)$/.test(color);
	};

	const getDocumentSurface = () => {
		const bodyColor = window.getComputedStyle(document.body).backgroundColor;
		if (!isTransparentColor(bodyColor)) return bodyColor;

		const rootColor = window.getComputedStyle(document.documentElement).backgroundColor;
		if (!isTransparentColor(rootColor)) return rootColor;

		return "var(--background)";
	};

	const resolveColor = (color: string) => {
		if (color.startsWith("rgb")) return color;
		if (color.startsWith("#")) return color;

		const probe = document.createElement("span");
		probe.style.color = color;
		probe.style.position = "absolute";
		probe.style.pointerEvents = "none";
		probe.style.visibility = "hidden";
		document.body.append(probe);

		const resolvedColor = window.getComputedStyle(probe).color;
		probe.remove();

		return resolvedColor;
	};

	const getRgbChannels = (color: string) => {
		const resolvedColor = resolveColor(color).trim();
		const rgbMatch = resolvedColor.match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)/);

		if (rgbMatch) {
			return rgbMatch.slice(1, 4).map(Number);
		}

		if (/^#[0-9a-f]{6}$/i.test(resolvedColor)) {
			return [
				parseInt(resolvedColor.slice(1, 3), 16),
				parseInt(resolvedColor.slice(3, 5), 16),
				parseInt(resolvedColor.slice(5, 7), 16),
			];
		}

		return [255, 255, 255];
	};

	const getReadableForeground = (backgroundColor: string) => {
		const [red, green, blue] = getRgbChannels(backgroundColor).map((channel) => {
			const normalizedChannel = channel / 255;

			return normalizedChannel <= 0.03928
				? normalizedChannel / 12.92
				: ((normalizedChannel + 0.055) / 1.055) ** 2.4;
		});
		const luminance = 0.2126 * red + 0.7152 * green + 0.0722 * blue;

		return luminance > 0.45 ? "var(--foreground)" : "var(--surface-dark-foreground)";
	};

	const getSectionHeaderColor = () => {
		if (!header) return getDocumentSurface();

		const sampleY = Math.min(
			window.innerHeight - 1,
			Math.max(0, header.getBoundingClientRect().bottom + 2),
		);
		const sampleXs = [
			window.innerWidth / 2,
			window.innerWidth * 0.25,
			window.innerWidth * 0.75,
		];

		for (const sampleX of sampleXs) {
			let element = document.elementFromPoint(sampleX, sampleY) as HTMLElement | null;

			while (element && element !== document.documentElement) {
				if (element === header) {
					element = element.parentElement;
					continue;
				}

				if (element.dataset.headerBg) return element.dataset.headerBg;

				const color = window.getComputedStyle(element).backgroundColor;
				if (!isTransparentColor(color)) return color;

				element = element.parentElement;
			}
		}

		return getDocumentSurface();
	};

	const syncHeaderRule = () => {
		headerRuleFrame = 0;
		const hasScrolled = window.scrollY > 4;

		if (headerRule) {
			headerRule.style.transform = hasScrolled ? "scaleX(0)" : "scaleX(1)";
		}

		if (header) {
			if (hasScrolled) {
				const backgroundColor = getSectionHeaderColor();
				const foregroundColor = getReadableForeground(backgroundColor);

				header.style.backgroundColor = backgroundColor;
				header.style.setProperty("--foreground", foregroundColor);
				header.style.setProperty("--hero-threads", foregroundColor);
				header.style.setProperty("--primary", foregroundColor);
			} else {
				header.style.backgroundColor = "transparent";
				header.style.removeProperty("--foreground");
				header.style.removeProperty("--hero-threads");
				header.style.removeProperty("--primary");
			}
		}
	};

	const requestHeaderRuleSync = () => {
		if (headerRuleFrame) return;
		headerRuleFrame = window.requestAnimationFrame(syncHeaderRule);
	};

	syncHeaderRule();
	window.addEventListener("scroll", requestHeaderRuleSync, { passive: true });
	window.addEventListener("resize", requestHeaderRuleSync);
</script>
