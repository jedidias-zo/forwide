---
import { getLocale } from "../../i18n";
import contactImage from "../../assets/responsabilidad-page/asset-03.png";
const english = getLocale(Astro.url.pathname) === "en";
---

<section
	id="contactanos"
	class="relative bg-surface-light px-[var(--frame-inset)] pt-header text-foreground"
	aria-labelledby="contact-title"
>
	<div class="min-h-[70svh] border-x border-foreground px-[clamp(1rem,1.6vw,1.5rem)] pb-[clamp(4rem,8vw,8rem)] pt-[clamp(3rem,6vw,6rem)]">
		<div class="flex items-center justify-between gap-6" data-reveal-fade>
			<h1 id="contact-title" class="heading-h1 min-w-0">
				<slot name="title">{english ? "Contact" : "Contacto"}</slot>
			</h1>
			<svg class="h-[clamp(2.5rem,7vw,7rem)] w-[clamp(2.5rem,7vw,7rem)] shrink-0" viewBox="0 0 100 100" fill="none" aria-hidden="true">
				<path d="M15 15L85 85M20 85H85V20" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</div>

		<div class="mt-[clamp(2.5rem,5vw,5rem)] grid grid-cols-[minmax(0,0.24fr)_minmax(0,1fr)] items-start gap-[clamp(1rem,4vw,4rem)] md:grid-cols-[minmax(0,0.2fr)_minmax(0,1fr)]" data-reveal-fade>
			<figure class="aspect-[3/4] overflow-hidden bg-surface-soft">
				<slot name="image"><img src={contactImage.src} width={contactImage.width} height={contactImage.height} alt="" class="h-full w-full object-cover grayscale" loading="eager" /></slot>
			</figure>
			<div class="paragraph border-t border-foreground/40">
				<div class="flex flex-col gap-2 border-b border-foreground/40 py-4 md:flex-row md:items-center md:justify-between md:gap-6">
					<h2 class="text-[length:inherit] font-normal uppercase"><slot name="legal-label">Legal</slot></h2>
					<a href="mailto:admin@forwide.com" class="break-words hover:underline underline-offset-4 focus-visible:underline"><slot name="legal-email">admin@forwide.com</slot></a>
				</div>
				<div class="flex flex-col gap-2 border-b border-foreground/40 py-4 md:flex-row md:items-center md:justify-between md:gap-6">
					<h2 class="text-[length:inherit] font-normal uppercase"><slot name="support-label">{english ? "General support" : "Soporte general"}</slot></h2>
					<a href="mailto:support@forwide.com" class="break-words hover:underline underline-offset-4 focus-visible:underline"><slot name="support-email">support@forwide.com</slot></a>
				</div>
			</div>
		</div>
	</div>
</section>
