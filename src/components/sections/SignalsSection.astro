---
import { createTranslator, getLocale } from "../../i18n";
const t = createTranslator(getLocale(Astro.url.pathname));

import signalImage from "../../assets/livecook/livecook-food-001.png";
import ForwideLogo from "../brand/ForwideLogo.astro";

type SignalRow = {
	title: string;
	body: string;
	image?: typeof signalImage;
	imageAlt?: string;
	accent?: boolean;
};

type Props = {
	productOnly?: boolean;
	embedded?: boolean;
	title?: string;
	intro?: string;
	bridgeTitle?: string;
	bridgeBody?: string;
	rows?: SignalRow[];
	logoLabel?: string;
};

const {
	productOnly = false,
	embedded = false,
	title = t("Señales de una empresa de tecnología."),
	intro = t("La compañía ya muestra tres señales: un producto activo, una estructura reutilizable y una dirección capaz de abrir nuevos verticales."),
	bridgeTitle = t("Lo que se aprende en un vertical puede mejorar el siguiente."),
	bridgeBody = t("Ya existe un caso activo para probar experiencia, contenido, operación y tecnología en condiciones reales."),
	rows = [
		{
			title: t("Producto en marcha."),
			body: t("Ya existe un caso activo para probar experiencia, contenido, operación y tecnología en condiciones reales."),
			image: signalImage,
			imageAlt: t("Proceso de cocina usado como caso activo de LiveCook."),
		},
		{
			title: t("Visión de plataforma."),
			body: t("Forwide no se limita a Livecook. La compañía usa este primer caso para definir una forma de lanzar, operar, medir y aprender que pueda sostener futuros verticales sin empezar desde cero cada vez."),
		},
	],
	logoLabel = "Forwide",
} = Astro.props;

const visibleRows = productOnly ? rows.slice(0, 1) : rows;
const RowHeading = productOnly && !embedded ? "h2" : "h3";
const SectionTag = embedded ? "div" : "section";
---

<SectionTag
	id="senales"
	class:list={[
		"relative px-[var(--frame-inset)]",
		embedded ? "bg-surface-dark text-surface-dark-foreground" : "bg-surface-light text-foreground",
	]}
	aria-labelledby="signals-title"
	data-signals-section
>
	<div class:list={[embedded ? "border-t border-surface-dark-foreground/40" : "border-x border-foreground"]}>
		{!productOnly && (
				<>
				<div class="flex min-h-[clamp(20rem,31vw,29rem)] flex-col justify-center border-b border-foreground px-[clamp(1.25rem,1.6vw,1.5rem)] py-[clamp(4rem,7vw,6rem)]">
					<div class="max-w-[64rem]">
						<h2
							id="signals-title"
							class="heading-h2"
							data-signals-reveal-text
						>
							<slot name="title">{title}</slot>
						</h2>
						<p class="mt-[clamp(1.75rem,3vw,2.4rem)] max-w-[54rem] paragraph text-description-foreground" data-signals-reveal-text>
							<slot name="intro">{intro}</slot>
						</p>
					</div>
				</div>

				<div class="grid min-h-[clamp(8rem,10vw,10.5rem)] gap-8 border-b border-foreground px-[clamp(1.25rem,1.6vw,1.5rem)] py-[clamp(2rem,3.4vw,3rem)] lg:grid-cols-[1.15fr_0.8fr] lg:items-center">
					<h3 class="heading-h3 max-w-[52rem]" data-signals-reveal-text>
						<slot name="bridgeTitle">{bridgeTitle}</slot>
					</h3>
					<p class="max-w-[34rem] paragraph text-description-foreground lg:justify-self-end" data-signals-reveal-text>
						<slot name="bridgeBody">{bridgeBody}</slot>
					</p>
				</div>

				</>
		)}

		{
			visibleRows.map((row, index) => (
				<article
					class:list={[
						"grid gap-8 px-[clamp(1.25rem,1.6vw,1.5rem)] lg:grid-cols-[0.72fr_0.72fr_0.52fr] lg:items-center",
						embedded
							? "py-[clamp(1.5rem,2.5vw,2rem)]"
							: "min-h-[clamp(12rem,15vw,14rem)] border-b border-foreground py-[clamp(2.25rem,3.6vw,3.4rem)]",
						row.image && !embedded && "bg-surface-soft",
					]}
					data-signals-reveal-item
					data-signals-on-primary={row.accent ? "true" : undefined}
				>
					<RowHeading id={productOnly ? "signals-title" : undefined} class="heading-h3 max-w-[27rem]" data-signals-reveal-text>
						{index === 0 ? (<slot name="row-0-title">{row.title}</slot>) : (<>{row.title}</>)}
					</RowHeading>

					<p class:list={["max-w-[34rem] paragraph", embedded ? "text-surface-dark-foreground" : "text-description-foreground"]} data-signals-reveal-text>
						{index === 0 ? (<slot name="row-0-body">{row.body}</slot>) : (<>{row.body}</>)}
					</p>

					{row.image && (
						<figure class="w-full max-w-[24rem] overflow-hidden lg:justify-self-end" data-signals-reveal-fade>
							{index === 0 ? (<slot name="image-0-0"><img
								src={row.image.src}
								alt={row.imageAlt ?? ""}
								class="h-[6rem] w-full object-cover object-center lg:h-[6.2rem]"
								loading="lazy"
							/></slot>) : (<><img
								src={row.image.src}
								alt={row.imageAlt ?? ""}
								class="h-[6rem] w-full object-cover object-center lg:h-[6.2rem]"
								loading="lazy"
							/></>)}
						</figure>
					)}
				</article>
			))
		}

		{!productOnly && <div class="flex min-h-[clamp(22rem,34vw,32rem)] items-center justify-center border-b border-foreground px-[clamp(1.25rem,1.6vw,1.5rem)] py-[clamp(4rem,8vw,7rem)]" data-signals-reveal-item>
			<ForwideLogo title={logoLabel} class="w-[min(15rem,52vw)] text-muted-foreground" />
		</div>}
	</div>
</SectionTag>

<script>
	import { gsap } from "gsap";
	import { revealParagraph } from "../../scripts/revealParagraph";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const splitSignalsRows = (element: HTMLElement) => {
		if (revealParagraph(element)) return;
		if (element.dataset.signalsPrepared === "true") return;

		const text = element.textContent?.replace(/\s+/g, " ").trim();
		if (!text) return;

		const tokens = text.split(" ");
		element.textContent = "";

		const measureFragment = document.createDocumentFragment();
		tokens.forEach((token, index) => {
			const word = document.createElement("span");
			word.dataset.signalsWord = "";
			word.textContent = token;
			word.style.display = "inline-block";
			measureFragment.appendChild(word);

			if (index < tokens.length - 1) {
				measureFragment.appendChild(document.createTextNode(" "));
			}
		});
		element.appendChild(measureFragment);

		const words = Array.from(element.querySelectorAll<HTMLElement>("[data-signals-word]"));
		const rows: HTMLElement[][] = [];

		words.forEach((word) => {
			const rowTop = Math.round(word.offsetTop);
			const currentRow = rows.at(-1);
			const currentTop = currentRow?.[0] ? Math.round(currentRow[0].offsetTop) : null;

			if (!currentRow || currentTop === null || Math.abs(rowTop - currentTop) > 2) {
				rows.push([word]);
			} else {
				currentRow.push(word);
			}
		});

		const onPrimary = element.closest("[data-signals-on-primary='true']");
		element.textContent = "";

		rows.forEach((row, index) => {
			const line = document.createElement("span");
			line.className = "relative block overflow-hidden";

			const lineText = document.createElement("span");
			lineText.className = "inline-block";
			lineText.dataset.signalsLineText = "";
			lineText.textContent = row.map((word) => word.textContent).join(" ");

			const lineBar = document.createElement("span");
			lineBar.className = `pointer-events-none absolute inset-0 z-10 block ${onPrimary ? "bg-background" : "bg-reveal-bar"}`;
			lineBar.dataset.signalsLineBar = "";
			lineBar.setAttribute("aria-hidden", "true");

			line.append(lineText, lineBar);
			element.appendChild(line);

			if (index < rows.length - 1) {
				element.appendChild(document.createTextNode(" "));
			}
		});

		element.dataset.signalsPrepared = "true";
	};

	const prepareSignalsText = (root: HTMLElement) => {
		const lineText = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-signals-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-signals-line-bar]"));
		const fadeItems = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-signals-reveal-fade]"));

		gsap.set(lineText, { autoAlpha: 1, yPercent: 104 });
		gsap.set(lineBars, {
			autoAlpha: 1,
			xPercent: 0,
			scaleX: 1,
			transformOrigin: "left center",
		});
		gsap.set(fadeItems, { autoAlpha: 0, y: 18 });
	};

	const revealSignals = (root: HTMLElement) => {
		const lineText = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-signals-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-signals-line-bar]"));
		const fadeItems = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-signals-reveal-fade]"));
		const timeline = gsap.timeline({ defaults: { ease: "power3.out" } });

		timeline
			.to(lineText, {
				yPercent: 0,
				duration: 0.76,
				stagger: 0.045,
			})
			.to(
				lineBars,
				{
					xPercent: 104,
					duration: 0.82,
					stagger: 0.045,
				},
				"<",
			)
			.set(lineBars, { autoAlpha: 0 });

		if (fadeItems.length) {
			timeline.to(
				fadeItems,
				{
					autoAlpha: 1,
					y: 0,
					duration: 0.62,
					stagger: 0.08,
				},
				"-=0.42",
			);
		}
	};

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	document.querySelectorAll<HTMLElement>("[data-signals-reveal-text]").forEach(splitSignalsRows);

	document.querySelectorAll<HTMLElement>("[data-signals-section]").forEach((section) => {
		prepareSignalsText(section);

		if (reduceMotion) {
			gsap.set(section.querySelectorAll("[data-signals-line-text], [data-signals-reveal-fade]"), { clearProps: "all" });
			gsap.set(section.querySelectorAll("[data-signals-line-bar]"), { autoAlpha: 0 });
			return;
		}

		ScrollTrigger.create({
			trigger: section,
			start: "top 72%",
			once: true,
			onEnter: () => revealSignals(section),
		});
	});
</script>
