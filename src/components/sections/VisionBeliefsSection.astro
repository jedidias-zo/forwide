---
import { createTranslator, getLocale } from "../../i18n";
const t = createTranslator(getLocale(Astro.url.pathname));

import arrowRight from "../../assets/livecook-product-page/arrow-right.svg";
import beliefs01 from "../../assets/vision/beliefs/asset-01.png";
import beliefs02 from "../../assets/vision/beliefs/asset-02.png";
import waves from "../../assets/livecook-product-page/waves.svg";

type BeliefCard = {
	number: string;
	body: string;
	title: string;
	image: typeof beliefs01;
	imageAlt?: string;
	frame?: "low" | "high";
};

type PrincipleRow = {
	number: string;
	title: string;
	body?: string;
};

type Props = {
	eyebrow?: string;
	title?: string;
	cards?: BeliefCard[];
	principlesLabel?: string;
	principles?: PrincipleRow[];
};

const {
	eyebrow = t("[ Lo que creemos ]"),
	title = t("Creemos en tecnología con dirección."),
	cards = [
		{
			number: "[ 01 ]",
			body: t("Partimos de comportamientos, necesidades y oportunidades observables."),
			title: t("Resolver algo concreto"),
			image: beliefs01,
			imageAlt: t("Persona observando a través de binoculares."),
			frame: "low",
		},
		{
			number: "[ 02 ]",
			body: t("Interfaz, lenguaje, flujos, comunidad y operación forman parte del sistema. No son decoración."),
			title: t("La experiencia también es infraestructura"),
			image: beliefs02,
			imageAlt: t("Estructura de concreto usada como referencia de infraestructura."),
			frame: "high",
		},
	],
	principlesLabel = t("[ Nuestros principios ]"),
	principles = [
		{
			number: "[ 03 ]",
			title: t("Dejar aprendizaje acumulable"),
			body: t("Lo que se diseña, prueba y construye debe servir para mejorar lo siguiente."),
		},
		{
			number: "[ 04 ]",
			title: t("Escalar es mantener claridad"),
			body: t("Crecer no significa hacer más cosas. Significa sostener coherencia mientras aumenta la complejidad."),
		},
	],
} = Astro.props;
---

<section
	id="creencias"
	class="relative bg-surface-light px-[var(--frame-inset)] text-foreground"
	aria-labelledby="vision-beliefs-title"
	data-beliefs-section
>
	<div class="border-x border-foreground">
		<div class="px-[clamp(1rem,1.6vw,1.5rem)] pb-[clamp(2.5rem,5vw,4.5rem)] pt-[clamp(4rem,7vw,6.5rem)]" data-beliefs-reveal-group>
			<p class="eyebrow mb-[clamp(2rem,3.5vw,3rem)]" data-beliefs-reveal-text>
				<slot name="eyebrow">{eyebrow}</slot>
			</p>

			<h2
				id="vision-beliefs-title"
				class="heading-h2 max-w-[70rem]"
				data-beliefs-reveal-text
			>
				<slot name="title">{title}</slot>
			</h2>

			<figure class="mt-[clamp(2.5rem,5vw,4.5rem)]" data-beliefs-reveal-fade>
				<img src={arrowRight.src} alt="" class="h-auto w-full" loading="lazy" />
			</figure>
		</div>

		<div class="grid border-b border-foreground lg:grid-cols-2">
			{
				cards.map((card, index) => (
					<article class="flex min-w-0 flex-col" data-beliefs-reveal-item data-beliefs-reveal-group>
						<p class="px-[clamp(1rem,1.6vw,1.5rem)] pb-[clamp(0.6rem,0.9vw,0.85rem)] pt-[clamp(0.65rem,0.95vw,0.9rem)] text-[clamp(1rem,1.25vw,1.2rem)] font-normal uppercase leading-none tracking-normal text-muted-foreground" data-beliefs-reveal-text>
							{index === 0 ? (<slot name="card-0-number">{card.number}</slot>) : index === 1 ? (<slot name="card-1-number">{card.number}</slot>) : (<>{card.number}</>)}
						</p>

						<figure class="relative aspect-square w-full shrink-0 overflow-hidden bg-surface-soft" data-beliefs-reveal-fade>
							{index === 0 ? (<slot name="image-0-0"><img
								src={card.image.src}
								width={card.image.width}
								height={card.image.height}
								alt={card.imageAlt ?? ""}
								class="absolute inset-0 h-full w-full object-cover grayscale"
								loading="lazy"
								decoding="async"
							/></slot>) : index === 1 ? (<slot name="image-0-1"><img
								src={card.image.src}
								width={card.image.width}
								height={card.image.height}
								alt={card.imageAlt ?? ""}
								class="absolute inset-0 h-full w-full object-cover grayscale"
								loading="lazy"
								decoding="async"
							/></slot>) : (<><img
								src={card.image.src}
								width={card.image.width}
								height={card.image.height}
								alt={card.imageAlt ?? ""}
								class="absolute inset-0 h-full w-full object-cover grayscale"
								loading="lazy"
								decoding="async"
							/></>)}
						</figure>

						<div class="min-h-[clamp(9rem,12vw,11rem)] flex-1 px-[clamp(0.5rem,0.8vw,0.75rem)] py-[clamp(1.25rem,2vw,1.75rem)]">
							<p class="max-w-[42rem] paragraph text-description-foreground" data-beliefs-reveal-text>
								{index === 0 ? (<slot name="card-0-body">{card.body}</slot>) : index === 1 ? (<slot name="card-1-body">{card.body}</slot>) : (<>{card.body}</>)}
							</p>
							<h3 class="heading-h3 mt-2 max-w-[42rem]" data-beliefs-reveal-text>
								{index === 0 ? (<slot name="card-0-title">{card.title}</slot>) : index === 1 ? (<slot name="card-1-title">{card.title}</slot>) : (<>{card.title}</>)}
							</h3>
						</div>
					</article>
				))
			}
		</div>

		<article class="grid border-b border-foreground px-[clamp(1rem,1.6vw,1.5rem)] py-[clamp(2rem,3vw,2.75rem)] lg:grid-cols-[1fr_0.58fr] lg:items-start lg:gap-12" data-beliefs-reveal-item data-beliefs-reveal-group>
			<div>
				<p class="mb-[clamp(1.25rem,2vw,1.75rem)] text-[clamp(1rem,1.25vw,1.2rem)] font-normal uppercase leading-none tracking-normal text-muted-foreground" data-beliefs-reveal-text>
					<slot name="principle-0-number">{principles[0]?.number}</slot>
				</p>
				<h3 class="heading-h3" data-beliefs-reveal-text>
					<slot name="principle-0-title">{principles[0]?.title}</slot>
				</h3>
			</div>

			<p class="mt-[clamp(1.5rem,3vw,2.5rem)] max-w-[30rem] paragraph text-description-foreground lg:mt-0" data-beliefs-reveal-text>
				<slot name="principle-0-body">{principles[0]?.body}</slot>
			</p>
		</article>

		<div class="relative flex min-h-[clamp(7rem,9vw,8.5rem)] items-center justify-end overflow-hidden border-b border-foreground bg-surface-menu px-[clamp(1rem,1.6vw,1.5rem)]" data-beliefs-reveal-group>
			<img src={waves.src} alt="" class="absolute inset-0 h-full w-full object-cover object-left-bottom opacity-20" loading="lazy" data-beliefs-reveal-fade />
			<p class="relative z-10 text-right text-[clamp(1.8rem,3vw,3rem)] font-normal uppercase leading-none tracking-normal" data-beliefs-reveal-text>
				<slot name="principlesLabel">{principlesLabel}</slot>
			</p>
		</div>

		<article class="grid border-b border-foreground px-[clamp(1rem,1.6vw,1.5rem)] py-[clamp(2rem,3vw,2.75rem)] lg:grid-cols-[1fr_0.58fr] lg:items-start lg:gap-12" data-beliefs-reveal-item data-beliefs-reveal-group>
			<div>
				<p class="mb-[clamp(1.25rem,2vw,1.75rem)] text-[clamp(1rem,1.25vw,1.2rem)] font-normal uppercase leading-none tracking-normal text-muted-foreground" data-beliefs-reveal-text>
					<slot name="principle-1-number">{principles[1]?.number}</slot>
				</p>
				<h3 class="heading-h3" data-beliefs-reveal-text>
					<slot name="principle-1-title">{principles[1]?.title}</slot>
				</h3>
			</div>

			<p class="mt-[clamp(1.5rem,3vw,2.5rem)] max-w-[30rem] paragraph text-description-foreground lg:mt-0" data-beliefs-reveal-text>
				<slot name="principle-1-body">{principles[1]?.body}</slot>
			</p>
		</article>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { revealParagraph } from "../../scripts/revealParagraph";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const splitBeliefsRows = (element: HTMLElement) => {
		if (revealParagraph(element)) return;
		if (element.dataset.beliefsPrepared === "true") return;

		const text = element.textContent?.replace(/\s+/g, " ").trim();
		if (!text) return;

		const tokens = text.split(" ");
		element.textContent = "";

		const measureFragment = document.createDocumentFragment();
		tokens.forEach((token, index) => {
			const word = document.createElement("span");
			word.dataset.beliefsWord = "";
			word.textContent = token;
			word.style.display = "inline-block";
			measureFragment.appendChild(word);

			if (index < tokens.length - 1) {
				measureFragment.appendChild(document.createTextNode(" "));
			}
		});
		element.appendChild(measureFragment);

		const words = Array.from(element.querySelectorAll<HTMLElement>("[data-beliefs-word]"));
		const rows: HTMLElement[][] = [];

		words.forEach((word) => {
			const rowTop = Math.round(word.offsetTop);
			const currentRow = rows.at(-1);
			const currentTop = currentRow?.[0] ? Math.round(currentRow[0].offsetTop) : null;

			if (!currentRow || currentTop === null || Math.abs(rowTop - currentTop) > 2) {
				rows.push([word]);
			} else {
				currentRow.push(word);
			}
		});

		element.textContent = "";

		rows.forEach((row) => {
			const line = document.createElement("span");
			line.className = "relative block overflow-hidden";

			const lineText = document.createElement("span");
			lineText.className = "inline-block";
			lineText.dataset.beliefsLineText = "";
			lineText.textContent = row.map((word) => word.textContent).join(" ");

			const lineBar = document.createElement("span");
			lineBar.className = "pointer-events-none absolute inset-0 z-10 block bg-reveal-bar";
			lineBar.dataset.beliefsLineBar = "";
			lineBar.setAttribute("aria-hidden", "true");

			line.append(lineText, lineBar);
			element.appendChild(line);
		});

		element.dataset.beliefsPrepared = "true";
	};

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	document.querySelectorAll<HTMLElement>("[data-beliefs-reveal-text]").forEach(splitBeliefsRows);

	document.querySelectorAll<HTMLElement>("[data-beliefs-section]").forEach((section) => {
		const lineText = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-beliefs-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-beliefs-line-bar]"));
		const fadeItems = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-beliefs-reveal-fade]"));

		if (reduceMotion) {
			gsap.set([...lineText, ...fadeItems], { clearProps: "all" });
			gsap.set(lineBars, { autoAlpha: 0 });
			return;
		}

		gsap.set(lineText, { autoAlpha: 1, yPercent: 104 });
		gsap.set(lineBars, {
			autoAlpha: 1,
			xPercent: 0,
			scaleX: 1,
			transformOrigin: "left center",
		});
		gsap.set(fadeItems, { autoAlpha: 0, y: 18 });

		section.querySelectorAll<HTMLElement>("[data-beliefs-reveal-group]").forEach((group) => {
			ScrollTrigger.create({
				trigger: group,
				start: "top 86%",
				once: true,
				onEnter: () => {
					const groupLineText = gsap.utils.toArray<HTMLElement>(group.querySelectorAll("[data-beliefs-line-text]"));
					const groupLineBars = gsap.utils.toArray<HTMLElement>(group.querySelectorAll("[data-beliefs-line-bar]"));
					const groupFadeItems = gsap.utils.toArray<HTMLElement>(group.querySelectorAll("[data-beliefs-reveal-fade]"));

				const timeline = gsap.timeline({ defaults: { ease: "power3.out" } });

				timeline
					.to(groupLineText, {
						yPercent: 0,
						duration: 0.72,
						stagger: 0.018,
					})
					.to(
						groupLineBars,
						{
							xPercent: 104,
							duration: 0.78,
							stagger: 0.018,
						},
						"<",
					)
					.set(groupLineBars, { autoAlpha: 0 })
					.to(
						groupFadeItems,
						{
							autoAlpha: 1,
							y: 0,
							duration: 0.62,
							stagger: 0.07,
						},
						"-=0.58",
					);
				},
			});
		});
	});
</script>
