---
import HeroBackgroundManager from '../reactbits/HeroBackgroundManager.jsx';
import ForwideLogo from '../brand/ForwideLogo.astro';

type HeadlineSegment = {
	text: string;
	muted?: boolean;
};

type Props = {
	intro?: string;
	headlineLines?: HeadlineSegment[][];
};

const {
	intro = "Forwide es la estructura desde la que nacen productos digitales presentes y futuros. LiveCook es el primer caso activo: una prueba real para validar tecnología, operación y modelo antes de abrir nuevos verticales con más criterio y menos improvisación.",
	headlineLines = [
		[{ text: "Convertimos oportunidades " }],
		[{ text: "digitales en " }, { text: "productos reales.", muted: true }],
	],
} = Astro.props;
---

<section
	class="relative isolate min-h-[100svh] overflow-hidden bg-background px-[var(--frame-inset)] pt-header text-foreground"
	aria-labelledby="hero-title"
>
	<HeroBackgroundManager client:load />

	<div
		class="relative z-10 grid min-h-[calc(100svh-var(--header-height))] grid-rows-[1fr_auto] gap-10 px-4 pb-10 pt-6 lg:gap-12 lg:pb-16 lg:pt-8"
	>
		<div class="flex min-h-0 flex-col gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
			<a
				href="/"
				aria-label="Forwide home"
				class="block w-[min(16.375rem,62vw)] shrink-0 lg:w-[16.375rem]"
				data-reveal-logo
			>
				<ForwideLogo animated class="h-auto w-full" />
			</a>

			<p
				class="max-w-[39rem] text-hero-intro font-normal leading-[1.2] text-pretty lg:ml-auto lg:text-right"
				data-reveal-copy
			>
				{intro}
			</p>
		</div>

		<h1
			id="hero-title"
			class="max-w-full text-[length:var(--hero-title-size)] text-section-heading"
		>
			{
				headlineLines.map((line) => (
					<span class="relative block overflow-hidden" data-reveal-heading-line>
						<span class="block" data-reveal-heading-text>
							{line.map((segment) => (
								<span class:list={[segment.muted && "text-foreground/50"]}>{segment.text}</span>
							))}
						</span>
						<span class="pointer-events-none absolute inset-0 z-10 block bg-reveal-bar" data-reveal-heading-bar aria-hidden="true" />
					</span>
				))
			}
		</h1>
	</div>
</section>
