---
import { createTranslator, getLocale } from "../../i18n";
const t = createTranslator(getLocale(Astro.url.pathname));

import visionHeroImage from "../../assets/vision/hero/asset-000.png";

type HeadlineSegment = {
	text: string;
	muted?: boolean;
};

type Props = {
	kicker?: string;
	body?: string;
	headlineLines?: HeadlineSegment[][];
};

const {
	kicker = t("[ Nuestro manifiesto ]"),
	body = t("Forwide convierte cada producto en tecnología, operación y aprendizaje reutilizable. LiveCook es el primer caso visible; la ambición es una compañía capaz de abrir nuevos verticales sin perder coherencia."),
	headlineLines = [
		[{ text: t("No lanzamos apps sueltas.") }],
		[{ text: t("Construimos una base para") }],
		[{ text: t("lanzar ") }, { text: t("mejor cada vez."), muted: true }],
	],
} = Astro.props;
---

<section
	class="relative min-h-[100svh] overflow-hidden bg-surface-menu px-[var(--frame-inset)] pt-header text-foreground"
	aria-labelledby="vision-hero-title"
>
	<div class="grid min-h-[calc(100svh-var(--header-height))] grid-rows-[auto_1fr] px-[clamp(1.25rem,1.6vw,1.5rem)] pb-[clamp(2.5rem,5vw,4rem)] pt-[clamp(3.5rem,7vw,5.5rem)]">
		<h1
			id="vision-hero-title"
			class="heading-h1 relative z-10"
		>
			{
				headlineLines.map((line, lineIndex) => (
					<span class="relative block overflow-hidden" data-reveal-heading-line>
						<span class="block" data-reveal-heading-text>
							{line.map((segment, segmentIndex) => (
								<span class:list={[segment.muted && "text-foreground/50"]}>{lineIndex === 0 && segmentIndex === 0 ? (<slot name="headline-0-0">{segment.text}</slot>) : lineIndex === 1 && segmentIndex === 0 ? (<slot name="headline-1-0">{segment.text}</slot>) : lineIndex === 2 && segmentIndex === 0 ? (<slot name="headline-2-0">{segment.text}</slot>) : lineIndex === 2 && segmentIndex === 1 ? (<slot name="headline-2-1">{segment.text}</slot>) : (<>{segment.text}</>)}</span>
							))}
						</span>
						<span class="pointer-events-none absolute inset-0 z-10 block bg-reveal-bar" data-reveal-heading-bar aria-hidden="true"></span>
					</span>
				))
			}
		</h1>

		<div class="relative grid min-h-[34rem] grid-cols-1 gap-[clamp(2rem,5vw,4rem)] pt-[clamp(2.25rem,5vw,4rem)] lg:grid-cols-[0.8fr_1fr] lg:items-start lg:pt-[clamp(3rem,5vw,5rem)]">
			<div class="relative z-10 flex h-full flex-col justify-between gap-[clamp(5rem,12vw,12rem)]">
				<p class="eyebrow" data-reveal-copy>
					<slot name="kicker">{kicker}</slot>
				</p>

				<p class="max-w-[36rem] paragraph text-pretty text-description-foreground" data-reveal-copy>
					<slot name="body">{body}</slot>
				</p>
			</div>

			<figure class="relative z-0 -mx-[clamp(1.25rem,1.6vw,1.5rem)] mt-0 self-end lg:mx-0 lg:-mt-[clamp(3rem,7vw,6rem)] lg:justify-self-end" data-reveal-fade>
				<slot name="image-0"><img
					src={visionHeroImage.src}
					width={visionHeroImage.width}
					height={visionHeroImage.height}
					alt=""
					class="aspect-[1.18] w-full object-cover object-[50%_26%] grayscale contrast-125 lg:w-[min(45vw,46rem)]"
					loading="eager"
					decoding="async"
					data-vision-morph-source
				/></slot>
			</figure>
		</div>
	</div>
</section>
