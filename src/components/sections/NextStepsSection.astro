---
import { createTranslator, getLocale } from "../../i18n";
const t = createTranslator(getLocale(Astro.url.pathname));

import livecookNextSteps from "../../assets/livecook/livecook-next-steps.png";

type Step = {
	title: string;
	body: string;
	image?: typeof livecookNextSteps;
	imageAlt?: string;
	imageCaption?: string;
};

type Props = {
	kicker?: string;
	headline?: string;
	steps?: Step[];
};

const {
	kicker = t("[ Forwide como estructura de productos ]"),
	headline = t("Forwide organiza presente y futuro bajo una misma capa de método, tecnología y marca."),
	steps = [
		{
			title: t("[ Ayer ]"),
			body: t("Antes de lanzar, Forwide observa, ordena y define qué vale la pena construir."),
		},
		{
			title: t("[ Hoy ] 2026"),
			body: "",
			image: livecookNextSteps,
			imageAlt: t("Plato de LiveCook como primer caso activo."),
			imageCaption: t("Livecook avanza como primer caso activo dentro del ecosistema."),
		},
		{
			title: t("[ Mañana ]"),
			body: t("Nuevos verticales pueden nacer desde aprendizajes, herramientas y criterios ya probados."),
		},
		{
			title: t("[ Siempre ]"),
			body: t("Forwide mantiene una lógica común: lanzar, operar, medir y ajustar."),
		},
	],
} = Astro.props;
---

<section
	id="siguientes-pasos"
	class="relative bg-surface-dark text-surface-dark-foreground"
	aria-labelledby="next-steps-title"
	data-next-steps-section
>
	<div class="pointer-events-none absolute inset-y-0 left-[var(--frame-inset)] z-20 w-px bg-surface-dark-foreground" aria-hidden="true"></div>
	<div class="pointer-events-none absolute inset-y-0 right-[var(--frame-inset)] z-20 w-px bg-surface-dark-foreground" aria-hidden="true"></div>

	<div class="relative" data-next-steps-transition>
		<div class="relative overflow-hidden bg-background">
			<div
				class="absolute left-1/2 top-1/2 h-[26rem] w-[calc(100vw-(var(--frame-inset)*2))] -translate-x-1/2 -translate-y-1/2 overflow-hidden bg-surface-dark lg:h-[21rem] lg:w-[24rem]"
				aria-hidden="true"
				data-next-steps-expander
			></div>

			<div
				class="relative z-10 flex flex-col justify-start gap-[clamp(1.25rem,5vw,2rem)] pl-[calc(var(--frame-inset)+1rem)] pr-[calc(var(--frame-inset)+1rem)] pb-12 pt-[clamp(3.75rem,13vw,5rem)] opacity-0 lg:grid lg:grid-cols-[18rem_1fr] lg:content-start lg:items-start lg:gap-[6rem] lg:pl-[calc(var(--frame-inset)+1.5rem)] lg:pr-[calc(var(--frame-inset)+1.5rem)] lg:pb-16 lg:pt-[clamp(5rem,9vw,7rem)]"
				data-next-steps-hero-content
			>
				<div class="max-w-[70rem] uppercase lg:col-start-2">
					<p class="eyebrow mb-[clamp(1.15rem,4vw,1.75rem)] lg:mb-[clamp(2rem,4vw,3rem)]" data-next-reveal-text>
						<slot name="kicker">{kicker}</slot>
					</p>
					<h2
						id="next-steps-title"
						class="heading-h2"
						data-next-reveal-text
					>
						<slot name="headline">{headline}</slot>
					</h2>
				</div>
			</div>
		</div>
	</div>

	{steps.length > 0 && <div class="px-[var(--frame-inset)] pb-[clamp(4rem,9vw,8rem)]">
		<div class="mx-auto w-full border-x border-b border-surface-dark-foreground/70 lg:grid lg:grid-cols-4 lg:items-stretch" data-next-steps-timeline>
			{
				steps.map((step, index) => (
					<article
						class:list={[
							"relative flex flex-col border-t border-surface-dark-foreground/70",
							index > 0 && "lg:border-l",
							index === 1 && "border-l border-surface-dark-foreground/70",
						]}
						data-next-reveal-item
					>
						<h3 class="heading-h3 border-b border-surface-dark-foreground/70 px-[clamp(1.25rem,2vw,1.75rem)] py-[clamp(0.95rem,1.6vw,1.35rem)] text-surface-dark-foreground" data-next-reveal-text>
							{step.title}
						</h3>

						<div class="flex flex-1 flex-col gap-[clamp(1rem,1.6vw,1.4rem)] px-[clamp(1.25rem,2vw,1.75rem)] py-[clamp(1.25rem,2vw,2rem)]">
							{step.image && (
								<figure class="flex flex-col gap-4">
									<img
										src={step.image.src}
										alt={step.imageAlt ?? ""}
										class="aspect-[1.32] w-full object-cover"
										loading="lazy"
									/>
									{step.imageCaption && (
										<figcaption class="paragraph text-surface-dark-muted" data-next-reveal-text>
											{step.imageCaption}
										</figcaption>
									)}
								</figure>
							)}

							{step.body && (
								<p class="max-w-[26rem] paragraph text-surface-dark-muted" data-next-reveal-text>
									{step.body}
								</p>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>}
	<slot />
</section>

<script>
	import { gsap } from "gsap";
	import { revealParagraph } from "../../scripts/revealParagraph";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const splitNextRows = (element: HTMLElement) => {
		if (revealParagraph(element)) return;
		if (element.dataset.nextPrepared === "true") return;

		const text = element.textContent?.replace(/\s+/g, " ").trim();
		if (!text) return;

		const tokens = text.split(" ");
		element.textContent = "";

		const measureFragment = document.createDocumentFragment();
		tokens.forEach((token, index) => {
			const word = document.createElement("span");
			word.dataset.nextWord = "";
			word.textContent = token;
			word.style.display = "inline-block";
			measureFragment.appendChild(word);

			if (index < tokens.length - 1) {
				measureFragment.appendChild(document.createTextNode(" "));
			}
		});
		element.appendChild(measureFragment);

		const words = Array.from(element.querySelectorAll<HTMLElement>("[data-next-word]"));
		const rows: HTMLElement[][] = [];

		words.forEach((word) => {
			const rowTop = Math.round(word.offsetTop);
			const currentRow = rows.at(-1);
			const currentTop = currentRow?.[0] ? Math.round(currentRow[0].offsetTop) : null;

			if (!currentRow || currentTop === null || Math.abs(rowTop - currentTop) > 2) {
				rows.push([word]);
			} else {
				currentRow.push(word);
			}
		});

		element.textContent = "";

		rows.forEach((row) => {
			const line = document.createElement("span");
			line.className = "relative block overflow-hidden";

			const lineText = document.createElement("span");
			lineText.className = "inline-block";
			lineText.dataset.nextLineText = "";
			lineText.textContent = row.map((word) => word.textContent).join(" ");

			const lineBar = document.createElement("span");
			lineBar.className = "pointer-events-none absolute inset-0 z-10 block bg-surface-soft";
			lineBar.dataset.nextLineBar = "";
			lineBar.setAttribute("aria-hidden", "true");

			line.append(lineText, lineBar);
			element.appendChild(line);
		});

		element.dataset.nextPrepared = "true";
	};

	const prepareNextText = (root: HTMLElement) => {
		const lineText = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-next-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-next-line-bar]"));

		gsap.set(lineText, { autoAlpha: 1, yPercent: 104 });
		gsap.set(lineBars, {
			autoAlpha: 1,
			xPercent: 0,
			scaleX: 1,
			transformOrigin: "left center",
		});
	};

	const appendNextTextReveal = (timeline, root: HTMLElement, position: string | number = 0) => {
		const lineText = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-next-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-next-line-bar]"));

		timeline
			.to(
				lineText,
				{
					yPercent: 0,
					duration: 0.78,
					stagger: 0.06,
				},
				position,
			)
			.to(
				lineBars,
				{
					xPercent: 104,
					duration: 0.82,
					stagger: 0.06,
				},
				"<",
			)
			.set(lineBars, { autoAlpha: 0 });
	};

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const sections = gsap.utils.toArray<HTMLElement>("[data-next-steps-section]");

	document.querySelectorAll<HTMLElement>("[data-next-reveal-text]").forEach(splitNextRows);

	sections.forEach((section) => {
		const transition = section.querySelector<HTMLElement>("[data-next-steps-transition]");
		const expander = section.querySelector<HTMLElement>("[data-next-steps-expander]");
		const content = section.querySelector<HTMLElement>("[data-next-steps-hero-content]");
		const items = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-next-reveal-item]"));
		const root = document.documentElement;
		const defaultFrameLine = getComputedStyle(root).getPropertyValue("--foreground").trim() || "var(--foreground)";
		const darkFrameLine = getComputedStyle(root).getPropertyValue("--surface-dark-foreground").trim() || "#fcfcfc";
		const setDarkFrame = () => root.style.setProperty("--frame-line", darkFrameLine);
		const resetFrame = () => root.style.setProperty("--frame-line", defaultFrameLine);

		if (!transition || !expander || !content) return;

		if (reduceMotion) {
			ScrollTrigger.create({
				trigger: section,
				start: "top center",
				end: "bottom center",
				onEnter: setDarkFrame,
				onEnterBack: setDarkFrame,
				onLeave: resetFrame,
				onLeaveBack: resetFrame,
			});
			gsap.set(expander, {
				width: "100vw",
				height: "100%",
			});
			gsap.set(content, { autoAlpha: 1 });
			gsap.set("[data-next-line-text]", { clearProps: "all" });
			gsap.set("[data-next-line-bar]", { autoAlpha: 0 });
			return;
		}

		ScrollTrigger.create({
			trigger: section,
			start: "top center",
			end: "bottom center",
			onEnter: setDarkFrame,
			onEnterBack: setDarkFrame,
			onLeave: resetFrame,
			onLeaveBack: resetFrame,
		});

		gsap.set(content, { autoAlpha: 0, y: 42 });
		prepareNextText(content);
		items.forEach((item) => {
			gsap.set(item, { autoAlpha: 0, y: 34 });
			prepareNextText(item);
		});

		const timeline = gsap.timeline({
			scrollTrigger: {
				trigger: transition,
				start: "top bottom",
				end: "bottom bottom",
				scrub: 0.9,
				invalidateOnRefresh: true,
			},
		});

		timeline
			.to(expander, {
				width: "100vw",
				height: "100%",
				ease: "none",
			})
			.to(
				content,
				{
					autoAlpha: 1,
					y: 0,
					duration: 0.42,
					ease: "power2.out",
				},
				0.46,
			);
		appendNextTextReveal(timeline, content, 0.58);

		items.forEach((item) => {
			ScrollTrigger.create({
				trigger: item,
				start: "top 82%",
				once: true,
				onEnter: () => {
					const itemTimeline = gsap.timeline({ defaults: { ease: "power3.out" } });
					itemTimeline
						.to(item, {
							autoAlpha: 1,
							y: 0,
							duration: 0.62,
						});
					appendNextTextReveal(itemTimeline, item, "-=0.42");
				},
			});
		});
	});
</script>
