---
import livecookNextSteps from "../../assets/livecook/livecook-next-steps.png";
import LightRays from "../reactbits/LightRays.jsx";

type Step = {
	title: string;
	body: string;
	image?: typeof livecookNextSteps;
	imageAlt?: string;
	imageCaption?: string;
};

type Props = {
	eyebrow?: string;
	kicker?: string;
	headline?: string;
	steps?: Step[];
};

const {
	eyebrow = "Siguientes pasos",
	kicker = "[ Forwide como estructura de productos ]",
	headline = "Forwide organiza presente y futuro bajo una misma capa de método, tecnología y marca.",
	steps = [
		{
			title: "[ Ayer ]",
			body: "Antes de lanzar, Forwide observa, ordena y define qué vale la pena construir.",
		},
		{
			title: "[ Hoy ] 2026",
			body: "",
			image: livecookNextSteps,
			imageAlt: "Plato de LiveCook como primer caso activo.",
			imageCaption: "Livecook avanza como primer caso activo dentro del ecosistema.",
		},
		{
			title: "[ Mañana ]",
			body: "Nuevos verticales pueden nacer desde aprendizajes, herramientas y criterios ya probados.",
		},
		{
			title: "[ Siempre ]",
			body: "Forwide mantiene una lógica común: lanzar, operar, medir y ajustar.",
		},
	],
} = Astro.props;
---

<section
	id="siguientes-pasos"
	class="relative bg-background text-foreground"
	aria-labelledby="next-steps-title"
	data-next-steps-section
>
	<div class="relative h-[125svh]" data-next-steps-transition>
		<div class="sticky top-0 h-[100svh] overflow-hidden bg-background">
			<div
				class="absolute left-1/2 top-1/2 h-[26rem] w-[calc(100vw-(var(--frame-inset)*2))] -translate-x-1/2 -translate-y-1/2 overflow-hidden bg-primary lg:h-[21rem] lg:w-[24rem]"
				aria-hidden="true"
				data-next-steps-expander
			>
				<div class="absolute inset-0 opacity-55 mix-blend-screen">
					<LightRays
						client:load
						raysOrigin="top-center"
						raysColor="#ffd0bd"
						raysSpeed={0.65}
						lightSpread={0.86}
						rayLength={1.45}
						pulsating
						fadeDistance={0.92}
						saturation={0.7}
						followMouse
						mouseInfluence={0.08}
						noiseAmount={0.04}
						distortion={0.035}
					/>
				</div>
			</div>

			<div
				class="relative z-10 flex h-full flex-col justify-center gap-[clamp(2rem,5vw,4rem)] px-[var(--frame-inset)] py-[clamp(4rem,10vw,7rem)] opacity-0 lg:grid lg:grid-cols-[18rem_1fr] lg:content-center lg:items-start lg:gap-[6rem]"
				data-next-steps-hero-content
			>
				<p class="text-[clamp(1rem,1.4vw,1.35rem)] font-semibold uppercase italic leading-none tracking-[-0.05em]" data-next-reveal-text>
					{eyebrow}
				</p>

				<div class="max-w-[70rem] uppercase">
					<p class="mb-[clamp(2rem,4vw,3rem)] text-[clamp(1.4rem,2.2vw,2rem)] font-medium leading-none tracking-[-0.05em]" data-next-reveal-text>
						{kicker}
					</p>
					<h2
						id="next-steps-title"
						class="text-[clamp(2rem,4.2vw,4.5rem)] font-black leading-[0.98] tracking-[-0.065em]"
						data-next-reveal-text
					>
						{headline}
					</h2>
				</div>
			</div>
		</div>
	</div>

	<div class="px-[var(--frame-inset)] py-[clamp(4rem,9vw,8rem)]">
		<div class="mx-auto w-full border-x border-primary/45 lg:grid lg:min-h-[43rem] lg:grid-cols-4 lg:items-start" data-next-steps-timeline>
			{
				steps.map((step, index) => (
					<article
						class:list={[
							"relative flex flex-col gap-6 px-[clamp(1.5rem,3vw,2.2rem)] py-[clamp(2.25rem,5vw,4rem)]",
							index > 0 && "lg:border-l lg:border-primary",
							index === 1 && "border-l-4 border-primary lg:border-l",
						]}
						data-next-reveal-item
					>
						<h3 class="text-[clamp(1.5rem,3.333vw,3rem)] font-black uppercase leading-none tracking-[-0.06em] text-primary" data-next-reveal-text>
							{step.title}
						</h3>

						{step.image && (
							<figure class="flex flex-col gap-4">
								<img
									src={step.image.src}
									alt={step.imageAlt ?? ""}
									class="aspect-[1.32] w-full object-cover"
									loading="lazy"
								/>
								{step.imageCaption && (
									<figcaption class="text-description font-medium" data-next-reveal-text>
										{step.imageCaption}
									</figcaption>
								)}
							</figure>
						)}

						{step.body && (
							<p class="max-w-[26rem] text-description font-medium" data-next-reveal-text>
								{step.body}
							</p>
						)}
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const splitNextRows = (element: HTMLElement) => {
		if (element.dataset.nextPrepared === "true") return;

		const text = element.textContent?.replace(/\s+/g, " ").trim();
		if (!text) return;

		const tokens = text.split(" ");
		element.textContent = "";

		const measureFragment = document.createDocumentFragment();
		tokens.forEach((token, index) => {
			const word = document.createElement("span");
			word.dataset.nextWord = "";
			word.textContent = token;
			word.style.display = "inline-block";
			measureFragment.appendChild(word);

			if (index < tokens.length - 1) {
				measureFragment.appendChild(document.createTextNode(" "));
			}
		});
		element.appendChild(measureFragment);

		const words = Array.from(element.querySelectorAll<HTMLElement>("[data-next-word]"));
		const rows: HTMLElement[][] = [];

		words.forEach((word) => {
			const rowTop = Math.round(word.offsetTop);
			const currentRow = rows.at(-1);
			const currentTop = currentRow?.[0] ? Math.round(currentRow[0].offsetTop) : null;

			if (!currentRow || currentTop === null || Math.abs(rowTop - currentTop) > 2) {
				rows.push([word]);
			} else {
				currentRow.push(word);
			}
		});

		element.textContent = "";

		rows.forEach((row) => {
			const line = document.createElement("span");
			line.className = "relative block overflow-hidden";

			const lineText = document.createElement("span");
			lineText.className = "inline-block";
			lineText.dataset.nextLineText = "";
			lineText.textContent = row.map((word) => word.textContent).join(" ");

			const lineBar = document.createElement("span");
			lineBar.className = "pointer-events-none absolute inset-0 z-10 block bg-primary";
			lineBar.dataset.nextLineBar = "";
			lineBar.setAttribute("aria-hidden", "true");

			line.append(lineText, lineBar);
			element.appendChild(line);
		});

		element.dataset.nextPrepared = "true";
	};

	const prepareNextText = (root: HTMLElement) => {
		const lineText = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-next-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-next-line-bar]"));

		gsap.set(lineText, { autoAlpha: 1, yPercent: 104 });
		gsap.set(lineBars, {
			autoAlpha: 1,
			xPercent: 0,
			scaleX: 1,
			transformOrigin: "left center",
		});
	};

	const appendNextTextReveal = (timeline, root: HTMLElement, position: string | number = 0) => {
		const lineText = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-next-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(root.querySelectorAll("[data-next-line-bar]"));

		timeline
			.to(
				lineText,
				{
					yPercent: 0,
					duration: 0.78,
					stagger: 0.06,
				},
				position,
			)
			.to(
				lineBars,
				{
					xPercent: 104,
					duration: 0.82,
					stagger: 0.06,
				},
				"<",
			)
			.set(lineBars, { autoAlpha: 0 });
	};

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const sections = gsap.utils.toArray<HTMLElement>("[data-next-steps-section]");

	document.querySelectorAll<HTMLElement>("[data-next-reveal-text]").forEach(splitNextRows);

	sections.forEach((section) => {
		const transition = section.querySelector<HTMLElement>("[data-next-steps-transition]");
		const expander = section.querySelector<HTMLElement>("[data-next-steps-expander]");
		const content = section.querySelector<HTMLElement>("[data-next-steps-hero-content]");
		const items = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-next-reveal-item]"));

		if (!transition || !expander || !content) return;

		if (reduceMotion) {
			gsap.set(expander, {
				width: "100vw",
				height: "100svh",
			});
			gsap.set(content, { autoAlpha: 1 });
			gsap.set("[data-next-line-text]", { clearProps: "all" });
			gsap.set("[data-next-line-bar]", { autoAlpha: 0 });
			return;
		}

		gsap.set(content, { autoAlpha: 0, y: 42 });
		prepareNextText(content);
		items.forEach((item) => {
			gsap.set(item, { autoAlpha: 0, y: 34 });
			prepareNextText(item);
		});

		const timeline = gsap.timeline({
			scrollTrigger: {
				trigger: transition,
				start: "top bottom",
				end: "bottom bottom",
				scrub: 0.9,
				invalidateOnRefresh: true,
			},
		});

		timeline
			.to(expander, {
				width: "100vw",
				height: "100svh",
				ease: "none",
			})
			.to(
				content,
				{
					autoAlpha: 1,
					y: 0,
					duration: 0.42,
					ease: "power2.out",
				},
				0.46,
			);
		appendNextTextReveal(timeline, content, 0.58);

		items.forEach((item) => {
			ScrollTrigger.create({
				trigger: item,
				start: "top 82%",
				once: true,
				onEnter: () => {
					const itemTimeline = gsap.timeline({ defaults: { ease: "power3.out" } });
					itemTimeline
						.to(item, {
							autoAlpha: 1,
							y: 0,
							duration: 0.62,
						});
					appendNextTextReveal(itemTimeline, item, "-=0.42");
				},
			});
		});
	});
</script>
