---
import { createTranslator, getLocale } from "../../i18n";
import type { ImageMetadata } from "astro";
import CtaButton from "../ui/CtaButton.astro";
import phoneImage from "../../assets/livecook-product-page/livecook-hero-phone.png";
import waves from "../../assets/livecook-product-page/waves-hero.svg";

const t = createTranslator(getLocale(Astro.url.pathname));

type Props = {
	title?: string;
	label?: string;
	body?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	ctaLabel?: string;
	ctaHref?: string;
};

const {
	title = t("La gastronomía sin fronteras. En tiempo real."),
	label = t("[ El primer producto de Forwide ]"),
	body = t("LiveCook no te manda a guardar otra receta. Te pone en una clase en directo: haces la receta, preguntas, sigues el ritmo del chef y terminas con un plato hecho. También es la primera prueba real de cómo Forwide convierte una idea en un producto que se usa."),
	image = phoneImage,
	imageAlt = t("Mockup de LiveCook mostrando el perfil de una chef dentro de la app."),
	ctaLabel = t("Conocer LiveCook"),
	ctaHref = "https://livecook.com",
} = Astro.props;
---

<section
	id="livecook-showcase"
	class="overflow-hidden bg-surface-soft px-[var(--frame-inset)] text-foreground"
	aria-labelledby="livecook-showcase-title"
>
	<div class="border-x border-foreground">

		<div class="border-b border-foreground/20 px-[clamp(1rem,1.25vw,1.25rem)] pb-[clamp(2.5rem,5vw,4rem)] pt-[clamp(3rem,6vw,6rem)]" data-reveal-scroll-fade>
			<p class="eyebrow mb-6"><slot name="products-label">[ Nuestros productos ]</slot></p>
			<div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-[clamp(2.5rem,5vw,5rem)]">
				<h2 class="heading-h3 max-w-[26rem]"><slot name="products-title">Distintos universos. Un mismo origen.</slot></h2>
				<p class="paragraph max-w-[40rem]"><slot name="products-body" /></p>
			</div>
		</div>

		<div class="grid items-end gap-[clamp(2.5rem,5vw,5rem)] px-[clamp(1rem,1.25vw,1.25rem)] pt-[clamp(3rem,6vw,6rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
			<figure class="relative isolate order-2 mx-auto w-full max-w-[33rem] self-end overflow-hidden pl-[3%] pr-[24%] pt-[clamp(4rem,7vw,7rem)] lg:order-1" data-reveal-scroll-fade>
				<img
					src={waves.src}
					alt=""
					aria-hidden="true"
					class="livecook-waves pointer-events-none absolute right-0 top-0 -z-10 h-[82%] w-[90%] max-w-none object-fill opacity-70"
					data-livecook-waves
					loading="lazy"
				/>
				<slot name="image-0"><img
					src={image.src}
					width={image.width}
					height={image.height}
					alt={imageAlt}
					class="h-auto w-full"
					loading="lazy"
					decoding="async"
				/></slot>
			</figure>

			<div class="relative z-10 order-1 min-w-0 max-w-[40rem] lg:order-2 lg:pb-[clamp(3rem,6vw,6rem)]" data-reveal-scroll-fade>

				<div class="space-y-5">
					<p class="eyebrow"><slot name="label">[ LiveCook ]</slot></p>
					<h3 id="livecook-showcase-title" class="heading-h3"><slot name="title">{title}</slot></h3>
					<p class="paragraph"><slot name="body">{body}</slot></p>
					<p class="paragraph"><slot name="experience" /></p>
					<CtaButton href={ctaHref} label={ctaLabel} class="mt-2"><slot name="cta-label">{ctaLabel}</slot></CtaButton>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.livecook-waves {
			transform-origin: 45% 60%;
			animation: livecook-wave-flow 20s ease-in-out infinite;
			animation-play-state: paused;
		}

		.livecook-waves[data-waves-active="true"] {
			animation-play-state: running;
			will-change: transform;
		}
	}

	@keyframes livecook-wave-flow {
		0%, 100% {
			transform: translate3d(-2%, 1%, 0) rotate(-2deg) scale(1, 0.98);
		}
		50% {
			transform: translate3d(2%, -1%, 0) rotate(2deg) scale(1.04, 1.06);
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>("[data-livecook-waves]").forEach((waves) => {
		let visible = false;
		const updatePlayback = () => {
			waves.dataset.wavesActive = String(visible && !document.hidden);
		};
		const observer = new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			updatePlayback();
		});
		observer.observe(waves);
		document.addEventListener("visibilitychange", updatePlayback);
		document.addEventListener("astro:before-swap", () => {
			observer.disconnect();
			document.removeEventListener("visibilitychange", updatePlayback);
		}, { once: true });
	});
</script>
