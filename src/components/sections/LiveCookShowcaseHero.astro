---
import { createTranslator, getLocale } from "../../i18n";
import type { ImageMetadata } from "astro";
import CtaButton from "../ui/CtaButton.astro";
import phoneImage from "../../assets/livecook-product-page/livecook-hero-phone.png";
import waves from "../../assets/livecook-product-page/waves-hero.svg";

const t = createTranslator(getLocale(Astro.url.pathname));

type Props = {
	title?: string;
	label?: string;
	body?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	ctaLabel?: string;
	ctaHref?: string;
};

const {
	title = t("Cocina en directo. Chefs reales. Desde cualquier lugar."),
	label = t("[ El primer producto de Forwide ]"),
	body = t("LiveCook no te manda a guardar otra receta. Te pone en una clase en directo: haces la receta, preguntas, sigues el ritmo del chef y terminas con un plato hecho. También es la primera prueba real de cómo Forwide convierte una idea en un producto que se usa."),
	image = phoneImage,
	imageAlt = t("Mockup de LiveCook mostrando el perfil de una chef dentro de la app."),
	ctaLabel = t("Conocer LiveCook"),
	ctaHref = "https://livecook.com",
} = Astro.props;
---

<section
	id="livecook-showcase"
	class="overflow-hidden bg-surface-soft px-[var(--frame-inset)] text-foreground"
	aria-labelledby="livecook-showcase-title"
>
	<div class="border-x border-foreground px-[clamp(1rem,1.25vw,1.25rem)] pt-[clamp(3.5rem,7vw,6rem)]">
		<h2 id="livecook-showcase-title" class="heading-h2 text-right" data-reveal-scroll-fade>
			<slot name="title">{title}</slot>
		</h2>

		<div class="mt-[clamp(3rem,6vw,6rem)] grid gap-[clamp(2.5rem,7vw,7rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:items-end">
			<figure class="relative isolate mx-auto w-full max-w-[33rem] self-end lg:mx-0" data-reveal-scroll-fade>
				<img
					src={waves.src}
					alt=""
					aria-hidden="true"
					class="livecook-waves pointer-events-none absolute -top-[clamp(3rem,8vw,8rem)] left-[12%] -z-10 w-[125%] max-w-none opacity-70"
					data-livecook-waves
					loading="lazy"
				/>
				<slot name="image-0"><img
					src={image.src}
					width={image.width}
					height={image.height}
					alt={imageAlt}
					class="h-auto w-full"
					loading="lazy"
					decoding="async"
				/></slot>
			</figure>

			<div class="relative z-10 flex flex-col items-start gap-6 pb-[clamp(3rem,4vw,4rem)] lg:gap-8" data-reveal-scroll-fade>
				<p class="paragraph max-w-[44ch]"><slot name="body">{body}</slot></p>
				<CtaButton href={ctaHref} label={ctaLabel} ><slot name="cta-label">{ctaLabel}</slot></CtaButton>
			</div>
		</div>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.livecook-waves {
			transform-origin: 45% 60%;
			animation: livecook-wave-flow 8s ease-in-out infinite alternate;
			animation-play-state: paused;
		}

		.livecook-waves[data-waves-active="true"] {
			animation-play-state: running;
			will-change: transform;
		}
	}

	@keyframes livecook-wave-flow {
		0% {
			transform: translate3d(-2%, 1%, 0) rotate(-3deg) scale(0.98, 0.96);
		}
		50% {
			transform: translate3d(1%, -1%, 0) rotate(0deg) scale(1.02, 1.04);
		}
		100% {
			transform: translate3d(3%, -2%, 0) rotate(3deg) scale(1.04, 1.08);
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>("[data-livecook-waves]").forEach((waves) => {
		let visible = false;
		const updatePlayback = () => {
			waves.dataset.wavesActive = String(visible && !document.hidden);
		};
		const observer = new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			updatePlayback();
		});
		observer.observe(waves);
		document.addEventListener("visibilitychange", updatePlayback);
		document.addEventListener("astro:before-swap", () => {
			observer.disconnect();
			document.removeEventListener("visibilitychange", updatePlayback);
		}, { once: true });
	});
</script>
