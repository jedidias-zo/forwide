---
import ForwideLogo from "../brand/ForwideLogo.astro";
---

<section
	id="forwide-logo"
	class="bg-surface-light px-[var(--frame-inset)] text-foreground"
	aria-label="Forwide"
	data-brand-logo-section
>
	<div class="flex min-h-[clamp(22rem,34vw,32rem)] items-center justify-center border-x border-foreground px-[clamp(1.25rem,1.6vw,1.5rem)] py-[clamp(4rem,8vw,7rem)]">
		<ForwideLogo class="w-[min(15rem,52vw)]" />
	</div>
</section>
