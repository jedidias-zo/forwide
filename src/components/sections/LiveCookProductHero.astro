---
import { createTranslator, getLocale } from "../../i18n";
import type { ImageMetadata } from "astro";
import CtaButton from "../ui/CtaButton.astro";
import LottieLogo from "../ui/LottieLogo.astro";
import kitchenImage from "../../assets/vision/full-width.png";
import livecookIcon from "../../assets/livecook-product-page/livecook-icon.png";

const t = createTranslator(getLocale(Astro.url.pathname));

type Props = {
	title?: string;
	intro?: string;
	body?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	icon?: ImageMetadata;
	ctaLabel?: string;
	ctaHref?: string;
};

const {
	title = t("Productos"),
	intro = t("Cada producto de Forwide tiene su propia marca y su propio público. Todos funcionan sobre la misma tecnología."),
	body = t("Clases de cocina en directo con chefs reales: cocinas a la vez que el chef, preguntas en el momento y terminas con tu plato hecho."),
	image = kitchenImage,
	imageAlt = t("Cocina profesional con superficies de acero y luces cálidas."),
	icon = livecookIcon,
	ctaLabel = t("Conocer LiveCook"),
	ctaHref = "https://livecook.com",
} = Astro.props;
---

<section
	id="livecook"
	class="bg-surface-soft pt-header text-foreground"
	aria-labelledby="livecook-product-title"
>
	<div class="px-[var(--frame-inset)]">
		<div class="border-x border-foreground px-[clamp(1rem,1.25vw,1.25rem)] py-[clamp(2rem,3vw,3rem)]">
			<h1 id="livecook-product-title" class="heading-h1" data-reveal-fade>
				<slot name="title">{title}</slot>
			</h1>
		</div>
	</div>

	<figure class="border-y border-foreground">
		<slot name="image-0"><img
			src={image.src}
			width={image.width}
			height={image.height}
			alt={imageAlt}
			class="aspect-[1.35] w-full object-cover object-center sm:aspect-auto sm:h-auto"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/></slot>
	</figure>

	<div class="px-[var(--frame-inset)]">
		<div class="border-x border-foreground px-[clamp(1rem,1.25vw,1.25rem)] pb-[clamp(2rem,3vw,3rem)] pt-[clamp(1.75rem,3vw,2.5rem)]">
			<p class="product-intro max-w-[68rem]" data-reveal-fade>
				<slot name="intro">{intro}</slot>
			</p>

			<div class="mt-[clamp(2rem,4vw,3rem)] grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-[clamp(1rem,2.5vw,1.75rem)] gap-y-6 md:grid-cols-[auto_minmax(0,1fr)_auto]" data-reveal-fade>
				<LottieLogo fallback={icon} class="w-[clamp(6rem,12vw,9rem)] self-center" />
				<p class="paragraph max-w-[44ch]">
					<slot name="body">{body}</slot>
				</p>
				<CtaButton
					href={ctaHref}
					label={ctaLabel}
					class="col-span-2 min-h-[3.25rem] justify-self-start px-4 md:col-span-1 md:justify-self-end"
				><slot name="cta-label">{ctaLabel}</slot></CtaButton>
			</div>
		</div>
	</div>
</section>
