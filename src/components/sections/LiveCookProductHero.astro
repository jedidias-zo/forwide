---
import CtaButton from "../ui/CtaButton.astro";
import heroMockup from "../../assets/livecook-product-page/hero-mockup.png";

type HeadlineSegment = {
	text: string;
	muted?: boolean;
};

type Props = {
	label?: string;
	headlineLines?: HeadlineSegment[][];
	body?: string;
	ctaLabel?: string;
	ctaHref?: string;
};

const {
	label = "[ El primer producto activo de Forwide ]",
	headlineLines = [
		[{ text: "Cocina en vivo. " }, { text: "Chefs", muted: true }],
		[{ text: "reales.", muted: true }, { text: " Desde cualquier" }],
		[{ text: "lugar." }],
	],
	body = "LiveCook no te manda a guardar otra receta. Te pone en una clase en directo: haces la receta, preguntas, sigues el ritmo del chef y terminas con un plato hecho. También es la primera prueba real de cómo Forwide lleva una idea al uso.",
	ctaLabel = "Conocer LiveCook",
	ctaHref = "#conocer-livecook",
} = Astro.props;
---

<section
	id="livecook"
	class="relative isolate min-h-[100svh] bg-surface-soft px-[var(--frame-inset)] pt-header text-foreground"
	aria-labelledby="livecook-product-title"
>
	<div class="relative min-h-[calc(100svh-var(--header-height))] border-x border-foreground px-[clamp(1rem,1.25vw,1.25rem)]">
		<div class="relative z-20 pt-[clamp(2rem,7vw,3.5rem)] lg:pt-[clamp(3.25rem,5vw,4.25rem)]">
			<h1
				id="livecook-product-title"
				class="livecook-product-title mx-auto max-w-[26rem] text-center lg:ml-auto lg:mr-0 lg:max-w-[76.5rem] lg:text-right"
				aria-label="Cocina en vivo. Chefs reales. Desde cualquier lugar."
			>
				{
					headlineLines.map((line) => (
						<span class="relative block overflow-hidden" data-reveal-heading-line>
							<span class="block" data-reveal-heading-text>
								{line.map((segment) => (
									<span class:list={[segment.muted && "text-foreground/50"]}>{segment.text}</span>
								))}
							</span>
							<span class="pointer-events-none absolute inset-0 z-10 block bg-reveal-bar" data-reveal-heading-bar aria-hidden="true" />
						</span>
					))
				}
			</h1>
		</div>

		<div class="relative z-30 mt-5 flex flex-col items-center pb-0 text-center lg:absolute lg:inset-x-[clamp(1rem,1.25vw,1.25rem)] lg:bottom-0 lg:top-[39%] lg:mt-0 lg:items-end lg:pb-[clamp(2rem,3.2vw,3.5rem)] lg:text-right">
			<p class="livecook-product-label" data-reveal-copy>
				{label}
			</p>

			<div class="mt-5 max-w-[22rem] lg:mt-auto lg:max-w-[43rem]">
				<p class="text-description font-normal text-foreground" data-reveal-copy>
					{body}
				</p>

				<CtaButton href={ctaHref} label={ctaLabel} class="mt-5 w-[13.5rem] lg:mt-[clamp(2rem,3vw,3rem)] lg:w-[15.5rem]" />
			</div>
		</div>

		<img
			src={heroMockup.src}
			width={heroMockup.width}
			height={heroMockup.height}
			alt="Mockup de LiveCook mostrando el perfil de una chef dentro de la app."
			class="relative z-10 mx-auto mt-6 h-auto w-[min(24rem,82vw)] max-w-none drop-shadow-[0_1.5rem_3rem_rgba(0,0,0,0.16)] lg:absolute lg:bottom-0 lg:left-0 lg:mx-0 lg:mt-0 lg:w-[min(46rem,47vw)]"
			loading="eager"
			decoding="async"
			data-reveal-fade
		/>
	</div>
</section>
