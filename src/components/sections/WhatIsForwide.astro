---
/*
 * Pillar card visuals: export at 448px wide (896px @2x).
 * Height = card minus text block (~190px) → ~340px @1x, or full-bleed top art at 448×340.
 * Card proportion is locked to 448×531 via aspect-[448/531].
 */
import pillarProductVisual from "../../assets/sections/what-is-forwide/pillar-product-visual.png";
import pillarSystemVisual from "../../assets/sections/what-is-forwide/pillar-system-visual.png";
import ScaleCardBackground from "../reactbits/ScaleCardBackground.jsx";

type Pillar = {
	index?: string;
	title: string;
	body: string;
	variant: "product" | "system" | "scale";
};

type Props = {
	eyebrow?: string;
	title?: string;
	intro?: string;
	pillars?: Pillar[];
};

const {
	eyebrow = "[ Qué es Forwide ]",
	title = "Tecnología antes que catálogo",
	intro = "Forwide articula producto, operación y escala desde una misma estructura. La compañía no lanza piezas sueltas: crea plataformas con lógica propia y aprendizaje reutilizable.",
	pillars = [
		{
			title: "Base de producto",
			body: "Forwide articula producto, operación y escala desde una misma estructura. La compañía no lanza piezas sueltas: crea plataformas con lógica propia y aprendizaje reutilizable.",
			variant: "product",
		},
		{
			title: "Base de sistema",
			body: "Ordena tecnología, procesos y aprendizaje para no empezar desde cero en cada lanzamiento.",
			variant: "system",
		},
		{
			index: "[03]",
			title: "Base de escala",
			body: "Diseña con una pregunta constante: qué puede crecer sin perder foco ni control.",
			variant: "scale",
		},
	],
} = Astro.props;

const pillarVisuals = {
	product: pillarProductVisual,
	system: pillarSystemVisual,
};

const cardBase =
	"relative flex aspect-[448/531] w-full min-h-0 flex-col overflow-hidden";
const contentClass = "relative z-10 flex shrink-0 flex-col gap-3 px-4 py-5";
const visualClass =
	"min-h-0 w-full flex-1 bg-cover bg-top bg-no-repeat";

const pillarVisualStyle = (variant: "product" | "system") => {
	const visual = pillarVisuals[variant];
	return `background-image: url('${visual.src}');`;
};
---

<section
	id="vision"
	class="bg-background px-[var(--frame-inset)] py-[clamp(4rem,10vw,7.5rem)] text-foreground"
	aria-labelledby="what-is-forwide-title"
	data-what-section
>
	<div class="flex w-full flex-col gap-10 lg:gap-12">
		<div class="flex flex-col gap-2.5">
			<div class="h-px w-full bg-[var(--frame-line)]" aria-hidden="true"></div>
			<div class="h-px w-full bg-[var(--frame-line)]" aria-hidden="true"></div>

			<div class="border-t border-primary pt-[clamp(3rem,8vw,5.25rem)]">
				<div class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:gap-12">
					<div class="flex min-w-0 flex-1 flex-col gap-6 uppercase">
						<p class="text-[1.25rem] font-medium italic leading-none tracking-[-0.04em] text-primary" data-what-reveal-text>
							{eyebrow}
						</p>
						<h2
							id="what-is-forwide-title"
							class="text-what-title font-black uppercase leading-none tracking-[-0.04em]"
							data-what-reveal-text
						>
							{title}
						</h2>
					</div>

					<p
						class="max-w-[27rem] text-description font-medium text-pretty lg:shrink-0"
						data-what-reveal-text
					>
						{intro}
					</p>
				</div>
			</div>
		</div>

		<div class="grid gap-2.5 lg:grid-cols-3">
			{
				pillars.map((pillar) => (
					<article
						class:list={[
							cardBase,
							pillar.variant === "product" && "border border-primary",
							pillar.variant === "system" && "bg-surface",
							pillar.variant === "scale" && "bg-primary text-foreground",
						]}
						data-what-reveal-card
					>
						{(pillar.variant === "product" || pillar.variant === "system") && (
							<div
								class={visualClass}
								style={pillarVisualStyle(pillar.variant)}
								role="img"
								aria-hidden="true"
							/>
						)}

						{pillar.variant === "scale" && (
							<div class="relative min-h-0 flex-1">
								<ScaleCardBackground client:visible />
								{pillar.index && (
									<p class="relative z-10 px-4 pt-5 text-[1.25rem] font-medium leading-none tracking-[-0.04em] text-primary-foreground" data-what-reveal-text>
										{pillar.index}
									</p>
								)}
							</div>
						)}

						<div class={contentClass}>
							<h3 class="text-what-card-title font-bold uppercase leading-none tracking-[-0.04em]" data-what-reveal-text>
								{pillar.title}
							</h3>
							<p
								class:list={[
									"text-description font-medium text-pretty",
									pillar.variant === "product" && "opacity-80",
									pillar.variant === "scale" && "opacity-80",
								]}
								data-what-reveal-text
							>
								{pillar.body}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const splitWhatRows = (element: HTMLElement) => {
		if (element.dataset.whatPrepared === "true") return;

		const text = element.textContent?.replace(/\s+/g, " ").trim();
		if (!text) return;

		const tokens = text.split(" ");
		element.textContent = "";

		const measureFragment = document.createDocumentFragment();
		tokens.forEach((token, index) => {
			const word = document.createElement("span");
			word.dataset.whatWord = "";
			word.textContent = token;
			word.style.display = "inline-block";
			measureFragment.appendChild(word);

			if (index < tokens.length - 1) {
				measureFragment.appendChild(document.createTextNode(" "));
			}
		});
		element.appendChild(measureFragment);

		const words = Array.from(element.querySelectorAll<HTMLElement>("[data-what-word]"));
		const rows: HTMLElement[][] = [];

		words.forEach((word) => {
			const rowTop = Math.round(word.offsetTop);
			const currentRow = rows.at(-1);
			const currentTop = currentRow?.[0] ? Math.round(currentRow[0].offsetTop) : null;

			if (!currentRow || currentTop === null || Math.abs(rowTop - currentTop) > 2) {
				rows.push([word]);
			} else {
				currentRow.push(word);
			}
		});

		const onPrimary = element.closest(".bg-primary");
		element.textContent = "";

		rows.forEach((row, index) => {
			const line = document.createElement("span");
			line.className = "relative block overflow-hidden";

			const lineText = document.createElement("span");
			lineText.className = "inline-block";
			lineText.dataset.whatLineText = "";
			lineText.textContent = row.map((word) => word.textContent).join(" ");

			const lineBar = document.createElement("span");
			lineBar.className = `pointer-events-none absolute inset-0 z-10 block ${onPrimary ? "bg-background" : "bg-primary"}`;
			lineBar.dataset.whatLineBar = "";
			lineBar.setAttribute("aria-hidden", "true");

			line.append(lineText, lineBar);
			element.appendChild(line);

			if (index < rows.length - 1) {
				element.appendChild(document.createTextNode(" "));
			}
		});

		element.dataset.whatPrepared = "true";
	};

	const prepareWhatSection = (section: HTMLElement) => {
		const lineText = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-line-bar]"));
		const cards = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-reveal-card]"));

		gsap.set(lineText, { autoAlpha: 1, yPercent: 104 });
		gsap.set(lineBars, {
			autoAlpha: 1,
			xPercent: 0,
			scaleX: 1,
			transformOrigin: "left center",
		});
		gsap.set(cards, { autoAlpha: 0, y: 24 });
	};

	const revealWhatSection = (section: HTMLElement) => {
		const lineText = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-line-bar]"));
		const cards = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-reveal-card]"));
		const timeline = gsap.timeline({ defaults: { ease: "power3.out" } });

		timeline
			.to(lineText, {
				yPercent: 0,
				duration: 0.76,
				stagger: 0.045,
			})
			.to(
				lineBars,
				{
					xPercent: 104,
					duration: 0.82,
					stagger: 0.045,
				},
				"<",
			)
			.set(lineBars, { autoAlpha: 0 })
			.to(
				cards,
				{
					autoAlpha: 1,
					y: 0,
					duration: 0.68,
					stagger: 0.1,
				},
				"-=0.42",
			);
	};

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	document.querySelectorAll<HTMLElement>("[data-what-reveal-text]").forEach(splitWhatRows);

	document.querySelectorAll<HTMLElement>("[data-what-section]").forEach((section) => {
		prepareWhatSection(section);

		if (reduceMotion) {
			gsap.set(section.querySelectorAll("[data-what-line-text], [data-what-reveal-card]"), { clearProps: "all" });
			gsap.set(section.querySelectorAll("[data-what-line-bar]"), { autoAlpha: 0 });
			return;
		}

		ScrollTrigger.create({
			trigger: section,
			start: "top 68%",
			once: true,
			onEnter: () => revealWhatSection(section),
		});
	});
</script>
