---
/*
 * Pillar card visuals: export at 448px wide (896px @2x).
 * Height = card minus text block (~190px) → ~340px @1x, or full-bleed top art at 448×340.
 * Card proportion is locked to 448×531 via aspect-[448/531].
 */
import pillarProductVisual from "../../assets/sections/what-is-forwide/pillar-product-visual.png";
import pillarSystemVisual from "../../assets/sections/what-is-forwide/pillar-system-visual.png";
import ScaleCardBackground from "../reactbits/ScaleCardBackground.jsx";

type Pillar = {
	index?: string;
	title: string;
	body: string;
	variant: "product" | "system" | "scale";
};

type Props = {
	eyebrow?: string;
	title?: string;
	intro?: string;
	pillars?: Pillar[];
};

const {
	eyebrow = "[ Qué es Forwide ]",
	title = "Tecnología antes que catálogo",
	intro = "Forwide articula producto, operación y escala desde una misma estructura. La compañía no lanza piezas sueltas: crea plataformas con lógica propia y aprendizaje reutilizable.",
	pillars = [
		{
			title: "Base de producto",
			body: "Forwide articula producto, operación y escala desde una misma estructura. La compañía no lanza piezas sueltas: crea plataformas con lógica propia y aprendizaje reutilizable.",
			variant: "product",
		},
		{
			title: "Base de sistema",
			body: "Ordena tecnología, procesos y aprendizaje para no empezar desde cero en cada lanzamiento.",
			variant: "system",
		},
		{
			index: "[03]",
			title: "Base de escala",
			body: "Diseña con una pregunta constante: qué puede crecer sin perder foco ni control.",
			variant: "scale",
		},
	],
} = Astro.props;

const pillarVisuals = {
	product: pillarProductVisual,
	system: pillarSystemVisual,
};

const cardBase =
	"relative flex aspect-[448/531] w-full min-h-0 flex-col overflow-hidden";
const contentClass = "relative z-10 flex shrink-0 flex-col gap-3 px-4 py-5";
const visualClass =
	"min-h-0 w-full flex-1 bg-cover bg-top bg-no-repeat";

const pillarVisualStyle = (variant: "product" | "system") => {
	const visual = pillarVisuals[variant];
	return `background-image: url('${visual.src}');`;
};
---

<section
	id="vision"
	class="bg-background px-[var(--frame-inset)] py-[clamp(4rem,10vw,7.5rem)] text-foreground"
	aria-labelledby="what-is-forwide-title"
>
	<div class="flex w-full flex-col gap-10 lg:gap-12">
		<div class="flex flex-col gap-2.5">
			<div class="h-px w-full bg-[var(--frame-line)]" aria-hidden="true"></div>
			<div class="h-px w-full bg-[var(--frame-line)]" aria-hidden="true"></div>

			<div class="border-t border-primary pt-[clamp(3rem,8vw,5.25rem)]">
				<div class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:gap-12">
					<div class="flex min-w-0 flex-1 flex-col gap-6 uppercase">
						<p class="text-[1.25rem] font-medium italic leading-none tracking-[-0.04em] text-primary">
							{eyebrow}
						</p>
						<h2
							id="what-is-forwide-title"
							class="text-what-title font-black uppercase leading-none tracking-[-0.04em]"
							data-reveal-heading
						>
							{title}
						</h2>
					</div>

					<p
						class="max-w-[27rem] text-description font-medium text-pretty lg:shrink-0"
						data-reveal-copy
					>
						{intro}
					</p>
				</div>
			</div>
		</div>

		<div class="grid gap-2.5 lg:grid-cols-3">
			{
				pillars.map((pillar) => (
					<article
						class:list={[
							cardBase,
							pillar.variant === "product" && "border border-primary",
							pillar.variant === "system" && "bg-surface",
							pillar.variant === "scale" && "bg-primary text-foreground",
						]}
					>
						{(pillar.variant === "product" || pillar.variant === "system") && (
							<div
								class={visualClass}
								style={pillarVisualStyle(pillar.variant)}
								role="img"
								aria-hidden="true"
							/>
						)}

						{pillar.variant === "scale" && (
							<div class="relative min-h-0 flex-1">
								<ScaleCardBackground client:visible />
								{pillar.index && (
									<p class="relative z-10 px-4 pt-5 text-[1.25rem] font-medium leading-none tracking-[-0.04em] text-primary-foreground">
										{pillar.index}
									</p>
								)}
							</div>
						)}

						<div class={contentClass}>
							<h3 class="text-what-card-title font-bold uppercase leading-none tracking-[-0.04em]">
								{pillar.title}
							</h3>
							<p
								class:list={[
									"text-description font-medium text-pretty",
									pillar.variant === "product" && "opacity-80",
									pillar.variant === "scale" && "opacity-80",
								]}
							>
								{pillar.body}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
