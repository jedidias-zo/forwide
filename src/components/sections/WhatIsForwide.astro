---
import { createTranslator, getLocale } from "../../i18n";
const t = createTranslator(getLocale(Astro.url.pathname));

/*
 * Pillar card visuals: export at ~347px square inside a 428px-tall frame (896px @2x).
 * Card proportion follows Figma 448×631; grid locks to aspect-[448/631] on large screens.
 */
import productBase from "../../assets/sections/what-is-forwide/product-base.png";
import systemBase from "../../assets/sections/what-is-forwide/system-base.png";
import baseScale from "../../assets/sections/what-is-forwide/base-scale.png";
import type { ImageMetadata } from "astro";

type Pillar = {
	index: string;
	title: string;
	body: string;
	visual: ImageMetadata;
};

type Props = {
	eyebrow?: string;
	title?: string;
	intro?: string;
	pillars?: Pillar[];
};

const {
	eyebrow = t("[ Qué es Forwide ]"),
	title = t("Tecnología antes que catálogo."),
	intro = t("Forwide articula producto, operación y escala desde una misma estructura. La compañía no lanza piezas sueltas: crea plataformas con lógica propia y aprendizaje reutilizable."),
	pillars = [
		{
			index: "001",
			title: t("Base de producto"),
			body: t("Forwide articula producto, operación y escala desde una misma estructura. La compañía no lanza piezas sueltas: crea plataformas con lógica propia y aprendizaje reutilizable."),
			visual: productBase,
		},
		{
			index: "002",
			title: t("Base de sistema"),
			body: t("Ordena tecnología, procesos y aprendizaje para no empezar desde cero en cada lanzamiento."),
			visual: systemBase,
		},
		{
			index: "003",
			title: t("Base de escala"),
			body: t("Diseña con una pregunta constante: qué puede crecer sin perder foco ni control."),
			visual: baseScale,
		},
	],
} = Astro.props;
---

<section
	id="vision"
	class="border-t border-foreground bg-background px-[var(--frame-inset)] py-[clamp(4rem,8vw,4rem)] text-foreground"
	aria-labelledby="what-is-forwide-title"
	data-what-section
>
	<div class="flex w-full flex-col gap-[clamp(3rem,8vw,5.25rem)]">
		<div class="flex flex-col items-start gap-8 px-4 lg:flex-row lg:items-end lg:gap-12">
			<div class="flex min-w-0 flex-1 flex-col gap-6 uppercase">
				<p class="eyebrow italic text-muted-foreground" data-what-reveal-text>
					<slot name="eyebrow">{eyebrow}</slot>
				</p>
				<h2
					id="what-is-forwide-title"
					class="heading-h2"
					data-what-reveal-text
				>
					<slot name="title">{title}</slot>
				</h2>
			</div>

			<p
				class="max-w-[27.125rem] paragraph text-description-foreground lg:shrink-0"
				data-what-reveal-text
			>
				<slot name="intro">{intro}</slot>
			</p>
		</div>

		<div class="grid gap-1 lg:grid-cols-3 lg:gap-0">
			{
				pillars.map((pillar, index) => (
					<article
						class:list={[
							"flex flex-col border border-foreground pb-6",
							index > 0 && "lg:border-l-0",
						]}
						data-what-reveal-card
					>
						<div class="flex items-center py-2 pl-4">
							<p class="text-[1rem] text-section-label uppercase text-foreground" data-what-reveal-text>
								{index === 0 ? (<slot name="pillar-0-index">{pillar.index}</slot>) : index === 1 ? (<slot name="pillar-1-index">{pillar.index}</slot>) : index === 2 ? (<slot name="pillar-2-index">{pillar.index}</slot>) : (<>{pillar.index}</>)}
							</p>
						</div>

						<div class="flex h-[clamp(16rem,42vw,26.75rem)] items-center justify-center border-y border-foreground bg-[var(--pillar-visual-bg)]">
							{index === 0 ? (<slot name="image-0-0"><img
								src={pillar.visual.src}
								width={pillar.visual.width}
								height={pillar.visual.height}
								alt=""
								class="h-full w-full object-cover object-center"
								loading="lazy"
								decoding="async"
							/></slot>) : index === 1 ? (<slot name="image-0-1"><img
								src={pillar.visual.src}
								width={pillar.visual.width}
								height={pillar.visual.height}
								alt=""
								class="h-full w-full object-cover object-center"
								loading="lazy"
								decoding="async"
							/></slot>) : index === 2 ? (<slot name="image-0-2"><img
								src={pillar.visual.src}
								width={pillar.visual.width}
								height={pillar.visual.height}
								alt=""
								class="h-full w-full object-cover object-center"
								loading="lazy"
								decoding="async"
							/></slot>) : (<><img
								src={pillar.visual.src}
								width={pillar.visual.width}
								height={pillar.visual.height}
								alt=""
								class="h-full w-full object-cover object-center"
								loading="lazy"
								decoding="async"
							/></>)}
						</div>

						<div class="relative flex flex-col gap-4 px-4 pt-4">
							<h3 class="heading-h3" data-what-reveal-text>
								{index === 0 ? (<slot name="pillar-0-title">{pillar.title}</slot>) : index === 1 ? (<slot name="pillar-1-title">{pillar.title}</slot>) : index === 2 ? (<slot name="pillar-2-title">{pillar.title}</slot>) : (<>{pillar.title}</>)}
							</h3>
							<p class="paragraph text-description-foreground" data-what-reveal-text>
								{index === 0 ? (<slot name="pillar-0-body">{pillar.body}</slot>) : index === 1 ? (<slot name="pillar-1-body">{pillar.body}</slot>) : index === 2 ? (<slot name="pillar-2-body">{pillar.body}</slot>) : (<>{pillar.body}</>)}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { revealParagraph } from "../../scripts/revealParagraph";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const splitWhatRows = (element: HTMLElement) => {
		if (revealParagraph(element)) return;
		if (element.dataset.whatPrepared === "true") return;

		const text = element.textContent?.replace(/\s+/g, " ").trim();
		if (!text) return;

		const tokens = text.split(" ");
		element.textContent = "";

		const measureFragment = document.createDocumentFragment();
		tokens.forEach((token, index) => {
			const word = document.createElement("span");
			word.dataset.whatWord = "";
			word.textContent = token;
			word.style.display = "inline-block";
			measureFragment.appendChild(word);

			if (index < tokens.length - 1) {
				measureFragment.appendChild(document.createTextNode(" "));
			}
		});
		element.appendChild(measureFragment);

		const words = Array.from(element.querySelectorAll<HTMLElement>("[data-what-word]"));
		const rows: HTMLElement[][] = [];

		words.forEach((word) => {
			const rowTop = Math.round(word.offsetTop);
			const currentRow = rows.at(-1);
			const currentTop = currentRow?.[0] ? Math.round(currentRow[0].offsetTop) : null;

			if (!currentRow || currentTop === null || Math.abs(rowTop - currentTop) > 2) {
				rows.push([word]);
			} else {
				currentRow.push(word);
			}
		});

		element.textContent = "";

		rows.forEach((row, index) => {
			const line = document.createElement("span");
			line.className = "relative block overflow-hidden";

			const lineText = document.createElement("span");
			lineText.className = "inline-block";
			lineText.dataset.whatLineText = "";
			lineText.textContent = row.map((word) => word.textContent).join(" ");

			const lineBar = document.createElement("span");
			lineBar.className = "pointer-events-none absolute inset-0 z-10 block bg-reveal-bar";
			lineBar.dataset.whatLineBar = "";
			lineBar.setAttribute("aria-hidden", "true");

			line.append(lineText, lineBar);
			element.appendChild(line);

			if (index < rows.length - 1) {
				element.appendChild(document.createTextNode(" "));
			}
		});

		element.dataset.whatPrepared = "true";
	};

	const prepareWhatSection = (section: HTMLElement) => {
		const lineText = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-line-bar]"));
		const cards = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-reveal-card]"));

		gsap.set(lineText, { autoAlpha: 1, yPercent: 104 });
		gsap.set(lineBars, {
			autoAlpha: 1,
			xPercent: 0,
			scaleX: 1,
			transformOrigin: "left center",
		});
		gsap.set(cards, { autoAlpha: 0, y: 24 });
	};

	const revealWhatSection = (section: HTMLElement) => {
		const lineText = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-line-text]"));
		const lineBars = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-line-bar]"));
		const cards = gsap.utils.toArray<HTMLElement>(section.querySelectorAll("[data-what-reveal-card]"));
		const timeline = gsap.timeline({ defaults: { ease: "power3.out" } });

		timeline
			.to(lineText, {
				yPercent: 0,
				duration: 0.76,
				stagger: 0.045,
			})
			.to(
				lineBars,
				{
					xPercent: 104,
					duration: 0.82,
					stagger: 0.045,
				},
				"<",
			)
			.set(lineBars, { autoAlpha: 0 })
			.to(
				cards,
				{
					autoAlpha: 1,
					y: 0,
					duration: 0.68,
					stagger: 0.1,
				},
				"-=0.42",
			);
	};

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	document.querySelectorAll<HTMLElement>("[data-what-reveal-text]").forEach(splitWhatRows);

	document.querySelectorAll<HTMLElement>("[data-what-section]").forEach((section) => {
		prepareWhatSection(section);

		if (reduceMotion) {
			gsap.set(section.querySelectorAll("[data-what-line-text], [data-what-reveal-card]"), { clearProps: "all" });
			gsap.set(section.querySelectorAll("[data-what-line-bar]"), { autoAlpha: 0 });
			return;
		}

		ScrollTrigger.create({
			trigger: section,
			start: "top 68%",
			once: true,
			onEnter: () => revealWhatSection(section),
		});
	});
</script>
