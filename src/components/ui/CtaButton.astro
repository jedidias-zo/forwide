---
import { getLocale, localisePath } from "../../i18n";
type Props = {
	href?: string;
	label?: string;
	variant?: "dark" | "light";
	class?: string;
};

const {
	href = "#",
	label = "",
	variant = "dark",
	class: className = "",
} = Astro.props;

const variantClasses = {
	dark: "cta-button-dark",
	light: "cta-button-light",
};
---

<a
	href={localisePath(href, getLocale(Astro.url.pathname))}
	class:list={[
		"cta-button",
		variantClasses[variant],
		className,
	]}
>
	<span><slot>{label}</slot></span>
</a>
