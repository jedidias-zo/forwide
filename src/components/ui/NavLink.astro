---
type Props = {
	label: string;
	href: string;
	isActive?: boolean;
	class?: string;
};

const {
	label,
	href,
	isActive = false,
	class: className = "",
} = Astro.props;
---

<a
	href={href}
	aria-current={isActive ? "page" : undefined}
	class:list={[
		"group inline-flex items-center justify-center overflow-visible font-normal uppercase leading-none text-current [letter-spacing:0]",
		className,
	]}
>
	<span
		aria-hidden="true"
		class="inline-block transition-transform duration-normal ease-standard group-hover:-translate-x-3 group-focus-visible:-translate-x-3"
	>
		[
	</span>
	<span class:list={["inline-block transition-transform duration-normal ease-standard", isActive && "line-through decoration-[0.08em]"]}>
		{label}
	</span>
	<span
		aria-hidden="true"
		class="inline-block transition-transform duration-normal ease-standard group-hover:translate-x-3 group-focus-visible:translate-x-3"
	>
		]
	</span>
</a>
