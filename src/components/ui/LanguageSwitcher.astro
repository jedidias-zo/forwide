---
import { getLocale, localisePath } from "../../i18n";

const locale = getLocale(Astro.url.pathname);
const targetLanguage = locale === "en" ? "es" : "en";
const label = targetLanguage === "es" ? "Español" : "English";
---

<nav aria-label={locale === "en" ? "Language" : "Idioma"} class="flex items-center text-xs font-normal leading-none">
	<a
		href={localisePath(Astro.url.pathname, targetLanguage)}
		lang={targetLanguage}
		hreflang={targetLanguage}
		aria-label={label}
		class="py-2 uppercase underline-offset-4 transition-colors hover:underline focus-visible:underline"
	>
		{label}
	</a>
</nav>
